# RECONSTRUCTED (D55): appended to ATM_DRV.f (after the ffdump_kppmix block). Written from the
# inserted text; not generated by diff, since the scratch tree was removed. Verify before applying.

+      subroutine ffdump_ovdiffs(tag,i,j,lmij,dt,u0,k,ghat,dtp4,
+     &     dtbydz,bydz2,u,fl)
+!@sum full-fidelity-port instrumentation: OVDIFFS's real inputs and
+!@+   outputs, Stage 2, D55 (OCNKPP.f:3470-3516), per call at OCONV's
+!@+   live G0ML (tag=0) and S0ML (tag=1) call sites.
+      use model_com, only : itime
+      implicit none
+      integer :: tag,i,j,lmij
+      real*8 :: dt
+      real*8 :: u0(13),k(13),ghat(13),dtp4(13),dtbydz(13),bydz2(13)
+      real*8 :: u(13),fl(13)
+      integer, save :: it0=-1, nst=0, init=0, lastit=-99, fu=1006
+      integer :: st
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (itime.ne.lastit) then
+        if (lastit.ge.0) close(fu)
+        lastit=itime
+        write(fname,'(A,I0,A)') 'ffz_ovdiffs_',itime,'.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      write(fu) dble(tag)
+      write(fu) dble(i)
+      write(fu) dble(j)
+      write(fu) dble(lmij)
+      write(fu) dt
+      write(fu) u0
+      write(fu) k
+      write(fu) ghat
+      write(fu) dtp4
+      write(fu) dtbydz
+      write(fu) bydz2
+      write(fu) u
+      write(fu) fl
+      end subroutine ffdump_ovdiffs
