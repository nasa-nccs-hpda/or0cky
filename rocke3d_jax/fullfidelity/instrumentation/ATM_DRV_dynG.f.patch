+      logical function ffds_on()
+!@sum D122 state dumps: true when env FFD_START/FFD_NSTEP select itime.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffds_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffds_on
+
+      subroutine ffds_state(site)
+!@sum D122: full atmosphere state dump, unit 1300,
+!@+   ffd_state_<itime>_s<site>.bin (big-endian float64 stream).
+!@+   site 1 = atm_phase1 entry (start of the step, before MAOLD=MA),
+!@+   2 = DYNAM exit, 3 = end of the dynamics block (after QCL/QCI
+!@+   rescale, QDYNAM and the energy fix, before CALC_TROP).
+!@+   Record: [itime,site,0,0], U,V,T,Q,QCL,QCI (im,jm,lm),
+!@+   MA (lm,im,jm), PEDN (lm+1,im,jm), PMID,PK (lm,im,jm), P,MASUM
+!@+   (im,jm), TMOM,QMOM (9,im,jm,lm), MUs,MVs,MWs,GZ (im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : u,v,t,q,qcl,qci,ma,pedn,pmid,pk,p,masum,
+     &     mus,mvs,mws,gz
+      use somtq_com, only : tmom,qmom
+      implicit none
+      integer :: site
+      logical, external :: ffds_on
+      integer :: fu
+      character(len=16) :: ts
+      character(len=160) :: fn
+      if (.not.ffds_on()) return
+      fu=1300
+      write(ts,'(i0)') itime
+      fn='ffd_state_'//trim(ts)//'_s'//char(48+site)//'.bin'
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dble(itime),dble(site),0d0,0d0
+      write(fu) u(1:im,1:jm,1:lm)
+      write(fu) v(1:im,1:jm,1:lm)
+      write(fu) t(1:im,1:jm,1:lm)
+      write(fu) q(1:im,1:jm,1:lm)
+      write(fu) qcl(1:im,1:jm,1:lm)
+      write(fu) qci(1:im,1:jm,1:lm)
+      write(fu) ma(1:lm,1:im,1:jm)
+      write(fu) pedn(1:lm+1,1:im,1:jm)
+      write(fu) pmid(1:lm,1:im,1:jm)
+      write(fu) pk(1:lm,1:im,1:jm)
+      write(fu) p(1:im,1:jm)
+      write(fu) masum(1:im,1:jm)
+      write(fu) tmom(1:9,1:im,1:jm,1:lm)
+      write(fu) qmom(1:9,1:im,1:jm,1:lm)
+      write(fu) mus(1:im,1:jm,1:lm)
+      write(fu) mvs(1:im,1:jm,1:lm)
+      write(fu) mws(1:im,1:jm,1:lm)
+      write(fu) gz(1:im,1:jm,1:lm)
+      close(fu)
+      end subroutine ffds_state
+
+      subroutine ffds_exports()
+!@sum D122: physics exports after CALC_TROP, PGRAD_PBL, WSAVE and the
+!@+   step-7 calc_kea_3d, unit 1300, ffd_state_<itime>_s4.bin:
+!@+   [itime,4,0,0], PTROPO,LTROPO(as double) (im,jm), WSAVE
+!@+   (im,jm,lm-1), KEA (im,jm,lm), DPDX_BY_RHO,DPDY_BY_RHO,
+!@+   DPDX_BY_RHO_0,DPDY_BY_RHO_0 (im,jm), PHI (im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : ptropo,ltropo,wsave,kea,phi,
+     &     dpdx_by_rho,dpdy_by_rho,dpdx_by_rho_0,dpdy_by_rho_0
+      implicit none
+      logical, external :: ffds_on
+      integer :: fu
+      character(len=16) :: ts
+      character(len=160) :: fn
+      if (.not.ffds_on()) return
+      fu=1300
+      write(ts,'(i0)') itime
+      fn='ffd_state_'//trim(ts)//'_s4.bin'
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dble(itime),4d0,0d0,0d0
+      write(fu) ptropo(1:im,1:jm)
+      write(fu) dble(ltropo(1:im,1:jm))
+      write(fu) wsave(1:im,1:jm,1:lm-1)
+      write(fu) kea(1:im,1:jm,1:lm)
+      write(fu) dpdx_by_rho(1:im,1:jm)
+      write(fu) dpdy_by_rho(1:im,1:jm)
+      write(fu) dpdx_by_rho_0(1:im,1:jm)
+      write(fu) dpdy_by_rho_0(1:im,1:jm)
+      write(fu) phi(1:im,1:jm,1:lm)
+      close(fu)
+      end subroutine ffds_exports
