+!@+   (after the ITER loop and the D-grid pass), Stage 2, D65. Record:
+!@+   i,j,lmij,kmuv,iter,hbl,kbl, ul,uld (13x74 each), g0ml,s0ml (13 each).
+      use model_com, only : itime
+      implicit none
+      integer :: i,j,lmij,kmuv,iter,kbl
+      real*8 :: hbl
+      real*8 :: ul(13,74),uld(13,74),g0ml(13),s0ml(13)
+      integer, save :: it0=-1, nst=0, init=0, lastit=-99, fu=1014
+      integer :: st
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (itime.ne.lastit) then
+        if (lastit.ge.0) close(fu)
+        lastit=itime
+        write(fname,'(A,I0,A)') 'ffz_hblout_',itime,'.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      write(fu) dble(i),dble(j),dble(lmij),dble(kmuv),dble(iter),hbl,
+     &     dble(kbl),ul,uld,g0ml,s0ml
+      end subroutine ffdump_hblout
