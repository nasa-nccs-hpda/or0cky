+      subroutine ffdump_hblin(i,j,lmij,kmuv,dts,dxypo,mo1,deltae,deltas,
+     &     deltam,deltasr,u2rho,ogeoz,hocean,mo,g0ml,g0ml0,s0ml,s0ml0,
+     &     ul,ul0,uld,uld0,ravm,lmuv,dtbydz,bydz2)
+!@sum full-fidelity-port instrumentation: OCONV HBL-loop state at entry
+!@+   (ITER=1), per column. Stage 2, D65. Record: 14 scalars, then
+!@+   mo,g0ml,g0ml0,s0ml,s0ml0 (13 each), ul,ul0,uld,uld0 (13x74 each),
+!@+   ravm,lmuv (74 each), dtbydz,bydz2 (13 each). 4101 doubles.
+      use model_com, only : itime
+      implicit none
+      integer :: i,j,lmij,kmuv
+      real*8 :: dts,dxypo,mo1,deltae,deltas,deltam,deltasr,u2rho,
+     &     ogeoz,hocean
+      real*8 :: mo(13),g0ml(13),g0ml0(13),s0ml(13),s0ml0(13)
+      real*8 :: ul(13,74),ul0(13,74),uld(13,74),uld0(13,74)
+      real*8 :: ravm(74)
+      integer :: lmuv(74)
+      real*8 :: dtbydz(13),bydz2(13)
+      integer, save :: it0=-1, nst=0, init=0, lastit=-99, fu=1013
+      integer :: st
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (itime.ne.lastit) then
+        if (lastit.ge.0) close(fu)
+        lastit=itime
+        write(fname,'(A,I0,A)') 'ffz_hblin_',itime,'.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      write(fu) dble(i),dble(j),dble(lmij),dble(kmuv),dts,dxypo,mo1,
+     &     deltae,deltas,deltam,deltasr,u2rho,ogeoz,hocean,
+     &     mo,g0ml,g0ml0,s0ml,s0ml0,ul,ul0,uld,uld0,ravm,
+     &     dble(lmuv),dtbydz,bydz2
+      end subroutine ffdump_hblin
+
+      subroutine ffdump_hblout(i,j,lmij,kmuv,iter,hbl,kbl,ul,uld,g0ml,
+     &     s0ml)
