D94/D95 helper routines (ffd_dynA_on, ffd_dynA_envi, ffd_avrx_site/_consts/ffd_avrx, ffd_iso, ffd_sdrag; units 1071-1079). Generated by diff -u against the PRISTINE ATM_DRV.f (2026-10-05); inserted after 'end subroutine read_aic' (unchanged code), so it applies to the pristine file or after other ATM_DRV.f patches. Uses only existing modules (model_com, geom, constant, FFT72, atm_com, dynamics, resolution).

--- ATM_DRV.f.orig
+++ ATM_DRV.f
@@ -1721,6 +1721,355 @@
 
       end subroutine read_aic
 
+      logical function ffd_dynA_on()
+!@sum full-fidelity-port instrumentation (D94/D95): true when env
+!@+   FFD_START/FFD_NSTEP select this itime.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffd_dynA_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffd_dynA_on
+
+      integer function ffd_dynA_envi(name,idef)
+!@sum D94/D95: integer from environment variable, default idef.
+      implicit none
+      character(len=*) :: name
+      integer :: idef,st
+      character(len=64) :: buf
+      ffd_dynA_envi=idef
+      call get_environment_variable(name,buf,status=st)
+      if (st.eq.0) read(buf,*) ffd_dynA_envi
+      end function ffd_dynA_envi
+
+      subroutine ffd_avrx_site(k)
+!@sum D94: called before each CALL AVRX (1:AFLUX 2:ADVECV 3:PGF);
+!@+   counts calls per (itime,site) and decides whether this call is
+!@+   sampled (every FFD_AVRX_STRIDE-th, default 17). Logs every call
+!@+   ([itime,site,ncall,sampled], 4 doubles, unit 1073).
+      use model_com, only : itime
+      implicit none
+      integer :: k
+      integer :: ncall(4),site,samp,stride,init,it
+      common /ffdavx/ ncall,site,samp,stride,init,it
+      logical, external :: ffd_dynA_on
+      integer, external :: ffd_dynA_envi
+      integer, parameter :: fu=1073
+      samp=0
+      if (.not.ffd_dynA_on()) return
+      if (init.eq.0) then
+        init=1
+        ncall=0
+        it=-1
+        stride=ffd_dynA_envi('FFD_AVRX_STRIDE',17)
+        open(fu,file='ffd_avrx_calls.bin',form='unformatted',
+     &       access='stream',status='replace')
+      endif
+      if (itime.ne.it) then
+        it=itime
+        ncall=0
+      endif
+      ncall(k)=ncall(k)+1
+      site=k
+      if (mod(ncall(k)-1,stride).eq.0) samp=1
+      write(fu) dble(itime),dble(k),dble(ncall(k)),dble(samp)
+      end subroutine ffd_avrx_site
+
+      subroutine ffd_avrx_consts(jm,drat,nmin,bysn)
+!@sum D94: AVRX SAVE tables (DRAT,NMIN,BYSN) + geometry + FFT C,S
+!@+   tables, written once (unit 1072, ffd_avrx_consts.bin).
+      use geom, only : dxp,dyp,bydyp,dlon
+      use FFT72, only : c,s
+      implicit none
+      integer :: jm,nmin(jm)
+      real*8 :: drat(jm),bysn(36)
+      integer :: ncall(4),site,samp,stride,init,it
+      common /ffdavx/ ncall,site,samp,stride,init,it
+      integer, save :: done=0
+      integer, parameter :: fu=1072
+      if (samp.eq.0 .or. done.ne.0) return
+      done=1
+      open(fu,file='ffd_avrx_consts.bin',form='unformatted',
+     &     access='stream',status='replace')
+      write(fu) dble(jm),dlon,bydyp(3)
+      write(fu) drat
+      write(fu) dble(nmin)
+      write(fu) dxp(1:jm)
+      write(fu) dyp(1:jm)
+      write(fu) bysn
+      write(fu) c
+      write(fu) s
+      close(fu)
+      end subroutine ffd_avrx_consts
+
+      subroutine ffd_avrx(mode,j,x,an,bn)
+!@sum D94: per-row hooks inside AVRX's row loop (rows with DRAT<=1).
+!@+   mode 1: before FFT (save X); 2: after FFT (save AN,BN);
+!@+   3: after FFTI (write record). Record (unit 1071,
+!@+   ffd_avrx.bin), 222 doubles: itime,site,ncall,j, X_in(72),
+!@+   AN(0:36),BN(0:36) (spectrum of X_in, before truncation scaling),
+!@+   X_out(72).
+      use model_com, only : itime
+      implicit none
+      integer :: mode,j
+      real*8 :: x(72),an(0:36),bn(0:36)
+      integer :: ncall(4),site,samp,stride,init,it
+      common /ffdavx/ ncall,site,samp,stride,init,it
+      real*8, save :: xin(72),ain(0:36),bin(0:36)
+      integer, save :: opened=0
+      integer, parameter :: fu=1071
+      if (samp.eq.0) return
+      if (mode.eq.1) then
+        xin=x
+      else if (mode.eq.2) then
+        ain=an
+        bin=bn
+      else
+        if (opened.eq.0) then
+          opened=1
+          open(fu,file='ffd_avrx.bin',form='unformatted',
+     &         access='stream',status='replace')
+        endif
+        write(fu) dble(itime),dble(site),dble(ncall(site)),dble(j)
+        write(fu) xin
+        write(fu) ain
+        write(fu) bin
+        write(fu) x
+        flush(fu)
+      endif
+      end subroutine ffd_avrx
+
+      subroutine ffd_iso(mode,j,l,k,fac,uin,vin,ua,va)
+!@sum D95: hooks inside isotropuv. mode 1 (after both shap1 calls,
+!@+   before the pole FFT): save inputs U,V of row (j,l), K, FAC, and
+!@+   the shap1 outputs UA,VA. mode 2 (after the back-conversion):
+!@+   uin,vin carry the NEW U,V row; write records.
+!@+   Every (j,l) goes to the stat file (unit 1075, ffd_isotr_stat.bin,
+!@+   8 doubles: itime,ncall,j,l,k,fac,n,max|u_in|).  Rows with
+!@+   mod(l,FFD_ISO_LSTRIDE)==1 (default 4) or n>1 go to the full file
+!@+   (unit 1074, ffd_isotr.bin, 8+6*72 doubles: itime,ncall,j,l,k,
+!@+   fac,n,hemi, U_in,V_in, UA,VA (post shap1), U_out,V_out).
+!@+   ncall counts isotropuv calls within the itime (1..5).
+      use model_com, only : itime
+      use resolution, only : im,jm
+      use geom, only : cosv,dxv,cosiv,siniv,fjeq
+      use constant, only : radius
+      use dynamics, only : dt
+      implicit none
+      integer :: mode,j,l
+      real*8 :: k,fac,uin(72),vin(72),ua(72),va(72)
+      logical, external :: ffd_dynA_on
+      integer, external :: ffd_dynA_envi
+      real*8, save :: su(72),sv(72),sua(72),sva(72),sk,sfac
+      integer, save :: init=0,ncall=0,it=-1,lstride=4,samp=0
+      integer :: n,hemi
+      integer, parameter :: fu=1074,fs=1075,fg=1076
+      if (mode.eq.1) then
+        samp=0
+        if (.not.ffd_dynA_on()) return
+        samp=1
+        if (init.eq.0) then
+          init=1
+          lstride=ffd_dynA_envi('FFD_ISO_LSTRIDE',4)
+          open(fu,file='ffd_isotr.bin',form='unformatted',
+     &         access='stream',status='replace')
+          open(fs,file='ffd_isotr_stat.bin',form='unformatted',
+     &         access='stream',status='replace')
+          open(fg,file='ffd_isotr_geom.bin',form='unformatted',
+     &         access='stream',status='replace')
+          write(fg) dble(jm),dble(im),dt,fjeq,radius
+          write(fg) cosv(1:jm)
+          write(fg) dxv(1:jm)
+          write(fg) cosiv(1:im)
+          write(fg) siniv(1:im)
+          close(fg)
+        endif
+        if (itime.ne.it) then
+          it=itime
+          ncall=0
+        endif
+        if (j.eq.2 .and. l.eq.1) ncall=ncall+1
+        su=uin
+        sv=vin
+        sua=ua
+        sva=va
+        sk=k
+        sfac=fac
+      else
+        if (samp.eq.0) return
+        n=int(sfac)+1
+        hemi=1
+        if (j.lt.fjeq) hemi=-1
+        write(fs) dble(itime),dble(ncall),dble(j),dble(l),sk,sfac,
+     &       dble(n),maxval(abs(su))
+        if (mod(l,lstride).eq.1 .or. n.gt.1) then
+          write(fu) dble(itime),dble(ncall),dble(j),dble(l),sk,sfac,
+     &         dble(n),dble(hemi)
+          write(fu) su
+          write(fu) sv
+          write(fu) sua
+          write(fu) sva
+          write(fu) uin
+          write(fu) vin
+        endif
+      endif
+      end subroutine ffd_iso
+
+      subroutine ffd_sdrag(mode,dt1)
+!@sum D95: hooks around SDRAG in DYNAM. mode 1: before (save inputs of
+!@+   the sampled columns, write stats); mode 2: after (write records).
+!@+   Columns: all J=2..JM, I = 1, 1+S, 1+2S.. (S=FFD_SDRAG_ISTRIDE,
+!@+   default 24).  Record (unit 1077, ffd_sdrag.bin), 5+10*LM doubles:
+!@+   itime,ncall,i,j,dt1; then (each length LM) U,V,T,PK(L,I,J),
+!@+   PEDN(L+1,I,J), MA(L,I+1,J-1), MA(L,I,J-1), MA(L,I+1,J), MA(L,I,J)
+!@+   (inputs), then U,V outputs.  Stats (unit 1079,
+!@+   ffd_sdrag_stat.bin, 10 doubles per call, from the FULL grid
+!@+   inputs): itime,ncall,dt1,n(L>=LS1,J=2..JM columns), n(wl>wmaxj),
+!@+   n(cd_lin),max wl,max|U change|,max|V change|, n(T out of
+!@+   100..373).  Constants once in ffd_sdrag_consts.bin (unit 1078;
+!@+   last double = RGAS).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm,ls1=>ls1_nominal
+      use atm_com, only : ma,u,v,t,pedn,pk
+      use geom, only : cosv,rapvn,rapvs,dxyv,dxyn,dxys
+      use constant, only : rgas
+      use dynamics, only : x_sdrag,csdragl,lsdrag,lpsdrag,ang_sdrag,
+     &     wc_jdrag,wmax,vsdragl,linear_sdrag
+      implicit none
+      integer :: mode
+      real*8 :: dt1
+      logical, external :: ffd_dynA_on
+      integer, external :: ffd_dynA_envi
+      integer, save :: init=0,ncall=0,it=-1,istr=24,samp=0
+      real*8, save :: du0(72,46,40),dv0(72,46,40)
+      real*8, save :: sdt1,wmaxp
+      real*8, allocatable, save :: cin(:,:)
+      integer, save :: nc=0
+      integer :: i,j,l,ip1,ic,ncols,nlev,nwl,ncl,nbad
+      real*8 :: wl,wmaxj,tl,mxw,mxu,mxv
+      logical :: cdl
+      integer, parameter :: fd=1077,fc=1078,fs=1079
+      if (mode.eq.1) then
+        samp=0
+        if (.not.ffd_dynA_on()) return
+        samp=1
+        if (init.eq.0) then
+          init=1
+          istr=ffd_dynA_envi('FFD_SDRAG_ISTRIDE',24)
+          allocate(cin(9*lm,im*jm))
+          open(fd,file='ffd_sdrag.bin',form='unformatted',
+     &         access='stream',status='replace')
+          open(fs,file='ffd_sdrag_stat.bin',form='unformatted',
+     &         access='stream',status='replace')
+          open(fc,file='ffd_sdrag_consts.bin',form='unformatted',
+     &         access='stream',status='replace')
+          write(fc) dble(lm),dble(ls1),dble(lsdrag),dble(lpsdrag),
+     &         dble(ang_sdrag),wc_jdrag,wmax,x_sdrag(1),x_sdrag(2)
+          if (linear_sdrag) then
+            write(fc) 1d0
+          else
+            write(fc) 0d0
+          endif
+          write(fc) dble(jm)
+          write(fc) csdragl(1:lm)
+          write(fc) vsdragl(1:lm)
+          write(fc) cosv(1:jm)
+          write(fc) rapvn(1:jm)
+          write(fc) rapvs(1:jm)
+          write(fc) dxyv(1:jm)
+          write(fc) dxyn(1:jm)
+          write(fc) dxys(1:jm)
+          write(fc) rgas
+          close(fc)
+        endif
+        if (itime.ne.it) then
+          it=itime
+          ncall=0
+        endif
+        ncall=ncall+1
+        sdt1=dt1
+        wmaxp=wmax*3.d0/4.d0
+        du0=u
+        dv0=v
+c stats over the full grid (inputs)
+        nlev=0; nwl=0; ncl=0; nbad=0; mxw=0.
+        do l=ls1,lm
+        do j=2,jm
+          wmaxj=wmax
+          if (cosv(j).le..15) wmaxj=wmaxp
+          cdl=.false.
+          if (l.ge.lsdrag .or.
+     &       (l.ge.lpsdrag.and.cosv(j).le..15)) cdl=.true.
+          do i=1,im
+            nlev=nlev+1
+            tl=t(i,j,l)*pk(l,i,j)
+            if (tl.lt.100..or.tl.gt.373.) nbad=nbad+1
+            wl=sqrt(u(i,j,l)*u(i,j,l)+v(i,j,l)*v(i,j,l))
+            if (wl.gt.wmaxj) nwl=nwl+1
+            if (cdl) ncl=ncl+1
+            if (wl.gt.mxw) mxw=wl
+          enddo
+        enddo
+        enddo
+        write(fs) dble(itime),dble(ncall),dt1,dble(nlev),dble(nwl),
+     &       dble(ncl),mxw,0d0,0d0,dble(nbad)
+c sampled columns
+        nc=0
+        do j=2,jm
+          do i=1,im,istr
+            nc=nc+1
+            ip1=i+1
+            if (ip1.gt.im) ip1=1
+            do l=1,lm
+              cin(l,nc)=u(i,j,l)
+              cin(lm+l,nc)=v(i,j,l)
+              cin(2*lm+l,nc)=t(i,j,l)
+              cin(3*lm+l,nc)=pk(l,i,j)
+              cin(4*lm+l,nc)=pedn(l+1,i,j)
+              cin(5*lm+l,nc)=ma(l,ip1,j-1)
+              cin(6*lm+l,nc)=ma(l,i,j-1)
+              cin(7*lm+l,nc)=ma(l,ip1,j)
+              cin(8*lm+l,nc)=ma(l,i,j)
+            enddo
+          enddo
+        enddo
+      else
+        if (samp.eq.0) return
+        ic=0
+        mxu=0.; mxv=0.
+        do j=2,jm
+          do i=1,im,istr
+            ic=ic+1
+            write(fd) dble(itime),dble(ncall),dble(i),dble(j),sdt1
+            write(fd) cin(1:9*lm,ic)
+            write(fd) u(i,j,1:lm)
+            write(fd) v(i,j,1:lm)
+          enddo
+        enddo
+        flush(fd)
+        do l=1,lm
+        do j=1,jm
+        do i=1,im
+          mxu=max(mxu,abs(u(i,j,l)-du0(i,j,l)))
+          mxv=max(mxv,abs(v(i,j,l)-dv0(i,j,l)))
+        enddo
+        enddo
+        enddo
+        write(fs) dble(itime),dble(ncall),sdt1,-1d0,-1d0,-1d0,-1d0,
+     &       mxu,mxv,-1d0
+        flush(fs)
+      endif
+      end subroutine ffd_sdrag
+
