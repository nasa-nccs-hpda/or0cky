D91-D93 helper-dump instrumentation (ffh_site, ffh_rec; units 1051-1056 for the six dumps, 1057 for consts/counts text). Generated by diff -u against the PRISTINE source (2026-10-05); anchored in unchanged code before '#ifdef CACHED_SUBDD / subroutine accum_subdd_atm', so it applies to the pristine file or after any other ATM_DRV.f patch.

--- ATM_DRV.f.orig
+++ ATM_DRV.f
@@ -1721,6 +1721,104 @@
 
       end subroutine read_aic
 
+      subroutine ffh_site(k)
+!@sum full-fidelity-port instrumentation (D91-D93): set the PRECIP_MP
+!@+   call-site id (1..8, see CONVECTIVE_MICROPHYSICS) before each call
+      implicit none
+      integer :: k
+      integer :: ffh_cur
+      common /ffhsite/ ffh_cur
+      ffh_cur=k
+      end subroutine ffh_site
+
+      subroutine ffh_rec(rt,site,n,v)
+!@sum full-fidelity-port instrumentation (D91-D93): sampled per-call
+!@+   record for the CLOUDS2 helper routines. rt: 1 PRECIP_MP
+!@+   2 ANVIL_OPTICAL_THICKNESS 3 MC_CLOUD_FRACTION 4 CONVECTIVE_
+!@+   MICROPHYSICS 5 MC_PRECIP_PHASE 6 MASS_FLUX. Record (big-endian
+!@+   f8 stream): itime,site,ncall,v(1:n). File ffc_<nm>_<itime>.bin,
+!@+   unit 1050+rt. A call is recorded when ncall<=2 or
+!@+   mod(ncall,stride(rt))==0 (ncall = running count of ALL calls at
+!@+   that (rt,site) in the step). Strides: env FFC_H_STRIDE_<NM>.
+!@+   Counts of all calls of the previous step -> ffc_h_counts.txt
+!@+   (the last step in the window is not flushed: ncall of its last
+!@+   record is a lower bound within one stride). Single thread.
+      use model_com, only : itime,dtsrc
+      use constant, only : rgas,grav,teeny,pi,by3,by6,twopi,lhe,lhs,
+     &     lhm,tf,bysha,deltx,rhow,mrat,rvap
+      implicit none
+      integer :: rt,site,n
+      real*8 :: v(n)
+      integer, save :: it0=-1, nst=0, init=0
+      integer, save :: stride(6)=(/1000,1,1,1,1,1/)
+      integer, save :: curit(6)=-1, ncall(6,8)=0
+      character(len=4), save :: nm(6)=(/'pmp ','anv ','mcf ','cmp ',
+     &     'mpp ','mf  '/)
+      character(len=2), save :: nmu(6)=(/'PM','AN','MC','CM','PP','MF'/)
+      integer :: st, fu, s, u2
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+        do s=1,6
+          call get_environment_variable('FFC_H_STRIDE_'//nmu(s),buf,
+     &         status=st)
+          if (st.eq.0) read(buf,*) stride(s)
+        enddo
+        if (it0.ge.0) then
+          open(1057,file='ffc_h_consts.txt',status='replace')
+          write(1057,'(A,ES26.17E3)') 'dtsrc ',dtsrc
+          write(1057,'(A,ES26.17E3)') 'rgas ',rgas
+          write(1057,'(A,ES26.17E3)') 'grav ',grav
+          write(1057,'(A,ES26.17E3)') 'teeny ',teeny
+          write(1057,'(A,ES26.17E3)') 'pi ',pi
+          write(1057,'(A,ES26.17E3)') 'by3 ',by3
+          write(1057,'(A,ES26.17E3)') 'by6 ',by6
+          write(1057,'(A,ES26.17E3)') 'twopi ',twopi
+          write(1057,'(A,ES26.17E3)') 'lhe ',lhe
+          write(1057,'(A,ES26.17E3)') 'lhs ',lhs
+          write(1057,'(A,ES26.17E3)') 'lhm ',lhm
+          write(1057,'(A,ES26.17E3)') 'tf ',tf
+          write(1057,'(A,ES26.17E3)') 'bysha ',bysha
+          write(1057,'(A,ES26.17E3)') 'deltx ',deltx
+          write(1057,'(A,ES26.17E3)') 'rhow ',rhow
+          write(1057,'(A,ES26.17E3)') 'mrat ',mrat
+          write(1057,'(A,ES26.17E3)') 'rvap ',rvap
+          do s=1,6
+            write(1057,'(A,A,I0)') 'stride_',nm(s),stride(s)
+          enddo
+          close(1057)
+        endif
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (site.lt.1 .or. site.gt.8) return
+      fu=1050+rt
+      if (itime.ne.curit(rt)) then
+        if (curit(rt).ge.0) then
+          close(fu)
+          open(1057,file='ffc_h_counts.txt',position='append')
+          write(1057,'(A,1X,I0,1X,I0,8(1X,I0))') nm(rt),curit(rt),rt,
+     &         ncall(rt,1:8)
+          close(1057)
+        endif
+        curit(rt)=itime
+        ncall(rt,:)=0
+        write(fname,'(A,A,A,I0,A)') 'ffc_',trim(nm(rt)),'_',itime,
+     &       '.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      ncall(rt,site)=ncall(rt,site)+1
+      if (ncall(rt,site).gt.2 .and.
+     &    mod(ncall(rt,site),stride(rt)).ne.0) return
+      write(fu) dble(itime),dble(site),dble(ncall(rt,site)),v
+      end subroutine ffh_rec
+
