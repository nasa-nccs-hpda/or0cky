D99-D100 helper routines ffdc_* (AADVT dump writers; units 1100 in/out, 1101 ns, 1102 checkpoints; ffd_aadvt_* files). Generated by diff -u against the PRISTINE ATM_DRV.f (2026-10-05); inserted after 'end subroutine alloc_drv_atm' (unchanged code, not an anchor of any other patch), so it applies to the pristine file or after the other ATM_DRV_*.patch files. Uses only existing modules (model_com, resolution, dynamics). Env FFD_START/FFD_NSTEP.

--- ATM_DRV.f.orig
+++ ATM_DRV.f
@@ -918,6 +918,202 @@
 #endif
       end subroutine alloc_drv_atm
 
+      logical function ffdc_on()
+!@sum full-fidelity-port instrumentation (D99-D100, AADVT): true when env
+!@+   FFD_START/FFD_NSTEP select this itime.  Units 1100-1102.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffdc_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffdc_on
+
+      subroutine ffdc_open(fu,ph)
+!@sum open ffd_aadvt_<itime>_c<call>_<ph>.bin (call = AADVT call index in this itime)
+      use model_com, only : itime
+      implicit none
+      integer :: fu
+      character(len=*) :: ph
+      character(len=200) :: fname
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      real*8 :: ffdc_sfac
+      common /ffdcsf/ ffdc_sfac
+      save /ffdcsf/
+      if (ffdc_sfac.eq.1d0) then
+        write(fname,'(A,I0,A,I0,A,A,A)') 'ffd_aadvt_',itime,'_c',
+     &       ffdc_nc,'_',trim(ph),'.bin'
+      else
+        write(fname,'(A,I0,A,I0,A,I0,A,A,A)') 'ffd_aadvtS',
+     &       nint(ffdc_sfac),'_',itime,'_c',ffdc_nc,'_',trim(ph),'.bin'
+      endif
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      end subroutine ffdc_open
+
+      subroutine ffdc_aadvt_in(dtlf,mma,t,tmom)
+!@sum AADVT inputs (unit 1100): ffd_aadvt_<itime>_c<k>_in.bin = [itime,k,DT,qlimit(0)],
+!@+   MMA (im,jm,lm), T (im,jm,lm), TMOM (9,im,jm,lm), MU,MV (im,jm,lm), MW (im,jm,lm-1).
+!@+   k = 1,2 : the two AADVT calls of one DYNAM (even leapfrog passes).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use dynamics, only : mu,mv,mw
+      implicit none
+      real*8 :: dtlf
+      real*8 :: mma(im,jm,lm),t(im,jm,lm),tmom(9,im,jm,lm)
+      logical, external :: ffdc_on
+      integer :: fu
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      integer, save :: init=0, sinit=0
+      integer :: st
+      character(len=64) :: buf
+      real*8 :: ffdc_sfac
+      common /ffdcsf/ ffdc_sfac
+      save /ffdcsf/
+      if (init.eq.0) then
+        init=1
+        ffdc_sfac=1d0
+        ffdc_last=-1 ; ffdc_nc=0 ; ffdc_act=0 ; ffdc_xsw=1
+        nsx=0 ; nsz=0
+      endif
+      if (itime.ne.ffdc_last) then
+        ffdc_last=itime
+        ffdc_nc=0
+      endif
+      ffdc_nc=ffdc_nc+1
+      ffdc_act=0
+      if (.not.ffdc_on()) return
+      ffdc_act=1
+      nsx=0 ; nsz=0
+!@+   STRESS TEST (off unless env FFD_AADVT_STRESS=<factor> is set): scale MU and MW
+!@+   seen by this AADVT call (module workspace, rewritten by the next AFLUX) so that
+!@+   the per-row Courant nstep>1 branches execute; files then get prefix ffd_aadvtS<factor>_.
+      if (sinit.eq.0) then
+        sinit=1
+        call get_environment_variable('FFD_AADVT_STRESS',buf,status=st)
+        if (st.eq.0) read(buf,*) ffdc_sfac
+      endif
+      if (ffdc_sfac.ne.1d0) then
+        mu(:,:,:)=mu(:,:,:)*ffdc_sfac
+        mw(:,:,:)=mw(:,:,:)*ffdc_sfac
+      endif
+      fu=1100
+      call ffdc_open(fu,'in')
+      write(fu) dble(itime),dble(ffdc_nc),dtlf,0d0
+      write(fu) mma
+      write(fu) t
+      write(fu) tmom
+      write(fu) mu(1:im,1:jm,1:lm)
+      write(fu) mv(1:im,1:jm,1:lm)
+      write(fu) mw(1:im,1:jm,1:lm-1)
+      close(fu)
+      end subroutine ffdc_aadvt_in
+
+      subroutine ffdc_aadvt_out(mma,t,tmom,fpeu,fpev)
+!@sum AADVT outputs (units 1100,1101): ffd_aadvt_<itime>_c<k>_out.bin = [itime,k], MMA,
+!@+   T (im,jm,lm), TMOM (9,im,jm,lm), FPEU, FPEV (im,jm); and ffd_aadvt_<itime>_c<k>_ns.bin
+!@+   = [itime,k], NSX(jm,lm,2) (per-row Courant nstep, X sweep 1 and 2), NSZ(im,jm) as doubles.
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      implicit none
+      real*8 :: mma(im,jm,lm),t(im,jm,lm),tmom(9,im,jm,lm),
+     &     fpeu(im,jm),fpev(im,jm)
+      integer :: fu
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      if (ffdc_act.eq.0) return
+      fu=1100
+      call ffdc_open(fu,'out')
+      write(fu) dble(itime),dble(ffdc_nc)
+      write(fu) mma
+      write(fu) t
+      write(fu) tmom
+      write(fu) fpeu
+      write(fu) fpev
+      close(fu)
+      fu=1101
+      call ffdc_open(fu,'ns')
+      write(fu) dble(itime),dble(ffdc_nc)
+      write(fu) dble(nsx)
+      write(fu) dble(nsz)
+      close(fu)
+      ffdc_act=0
+      end subroutine ffdc_aadvt_out
+
+      subroutine ffdc_setx(k)
+!@sum select which of the two X sweeps of AADVT is running (for the nstep record)
+      implicit none
+      integer :: k
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      ffdc_xsw=k
+      end subroutine ffdc_setx
+
+      subroutine ffdc_nsx(j,l,nstep)
+!@sum record the Courant sub-step count of row (j,l) of the current X sweep
+      implicit none
+      integer :: j,l,nstep
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      if (ffdc_act.eq.1) nsx(j,l,ffdc_xsw)=max(nsx(j,l,ffdc_xsw),nstep)
+      end subroutine ffdc_nsx
+
+      subroutine ffdc_nsz(i,j,nstep)
+!@sum record the Courant sub-step count of column (i,j) of the Z sweep
+      implicit none
+      integer :: i,j,nstep
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      if (ffdc_act.eq.1) nsz(i,j)=nstep
+      end subroutine ffdc_nsz
+
+      subroutine ffdc_ckpt(stage,im,jm,lm,rm,rmom,mm)
+!@sum AADVT per-sweep checkpoint (unit 1102): ffd_aadvt_<itime>_c<k>_s<stage>.bin
+!@+   = [itime,k,stage], RM (im,jm,lm), RMOM (9,im,jm,lm), MM (im,jm,lm), all in MASS units,
+!@+   stage 1 after X sweep 1, 2 after Y, 3 after Z.
+      use model_com, only : itime
+      implicit none
+      integer :: stage,im,jm,lm
+      real*8 :: rm(im,jm,lm),rmom(9,im,jm,lm),mm(im,jm,lm)
+      integer :: fu
+      character(len=2) :: ph
+      integer :: ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw
+      integer :: nsx(46,40,2),nsz(72,46)
+      common /ffdcst/ ffdc_last,ffdc_nc,ffdc_act,ffdc_xsw,nsx,nsz
+      save /ffdcst/
+      if (ffdc_act.eq.0) return
+      fu=1102
+      write(ph,'(A,I0)') 's',stage
+      call ffdc_open(fu,ph)
+      write(fu) dble(itime),dble(ffdc_nc),dble(stage)
+      write(fu) rm
+      write(fu) rmom
+      write(fu) mm
+      close(fu)
+      end subroutine ffdc_ckpt
+
