+      subroutine ffdump_me(kind,moe,g0me,gxme,gyme,gzme,s0me,sxme,
+     &     syme,szme)
+!@sum full-fidelity-port instrumentation: straits end-point arrays at
+!@+   STADV entry (kind=0) and exit (kind=1), Stage 2, D70.
+      use model_com, only : itime
+      implicit none
+      integer :: kind
+      real*8 :: moe(2,12,13),g0me(2,12,13),gxme(2,12,13),gyme(2,12,13)
+      real*8 :: gzme(2,12,13),s0me(2,12,13),sxme(2,12,13)
+      real*8 :: syme(2,12,13),szme(2,12,13)
+      integer, save :: it0=-1, nst=0, init=0
+      integer, save :: lastit(0:1)=-99
+      integer :: st, fu
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      fu=1024+kind
+      if (itime.ne.lastit(kind)) then
+        if (lastit(kind).ge.0) close(fu)
+        lastit(kind)=itime
+        if (kind.eq.0) then
+          write(fname,'(A,I0,A)') 'ffz_me_in_',itime,'.bin'
+        else
+          write(fname,'(A,I0,A)') 'ffz_me_out_',itime,'.bin'
+        endif
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      write(fu) moe,g0me,gxme,gyme,gzme,s0me,sxme,syme,szme
+      end subroutine ffdump_me
+
+      subroutine ffdump_pgf(kind,must,oprese,hoceane,lmme,moe,g0me,
+     &     gzme,s0me,szme,distpg,wist,lmst,dts)
+!@sum full-fidelity-port instrumentation: STPGF entry (kind=0) and exit
+!@+   (kind=1), Stage 2, D71.
