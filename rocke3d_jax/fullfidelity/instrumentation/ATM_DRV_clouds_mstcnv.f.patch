+      subroutine ffm_init
+!@sum full-fidelity-port instrumentation (D110): read the sampling
+!@+   configuration once. Env FFD_START/FFD_NSTEP (window), FFM_CSTRIDE
+!@+   (every Nth convective call is recorded, default 1), FFM_NSTRIDE
+!@+   (every Nth non-convective call, default 25), FFM_CKSTRIDE
+!@+   (checkpoints for calls with mod(ncall,stride)==0, default 3).
+      implicit none
+      integer :: it0,nst,cstr,nstr,ckstr
+      common /ffm_i/ it0,nst,cstr,nstr,ckstr
+      integer :: act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,ckf
+      common /ffm_j/ act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,
+     &     ckf
+      integer, save :: init=0
+      integer :: st
+      character(len=64) :: cb
+      if (init.ne.0) return
+      init=1
+      it0=-1
+      nst=0
+      cstr=1
+      nstr=25
+      ckstr=3
+      curit=-1
+      act=0
+      call get_environment_variable('FFD_START',cb,status=st)
+      if (st.eq.0) read(cb,*) it0
+      call get_environment_variable('FFD_NSTEP',cb,status=st)
+      if (st.eq.0) read(cb,*) nst
+      call get_environment_variable('FFM_CSTRIDE',cb,status=st)
+      if (st.eq.0) read(cb,*) cstr
+      call get_environment_variable('FFM_NSTRIDE',cb,status=st)
+      if (st.eq.0) read(cb,*) nstr
+      call get_environment_variable('FFM_CKSTRIDE',cb,status=st)
+      if (st.eq.0) read(cb,*) ckstr
+      end subroutine ffm_init
+
+      subroutine ffm_const(n,v)
+!@sum full-fidelity-port instrumentation (D110): one-time text file
+!@+   ffc_mc_consts.txt (unit 1202) with constants and MSTCNV tunables.
+      use model_com, only : dtsrc
+      use constant, only : rgas,grav,teeny,pi,by3,by6,tf,lhe,lhs,lhm,
+     &     bysha,deltx,sha,bygrav,mrat,rvap
+      implicit none
+      integer :: n
+      real*8 :: v(n)
+      integer :: it0,nst,cstr,nstr,ckstr
+      common /ffm_i/ it0,nst,cstr,nstr,ckstr
+      integer, save :: done=0
+      character(len=32) :: nm(26)
+      data nm(1) /'entrainment_cont1'/
+      data nm(2) /'entrainment_cont2'/
+      data nm(3) /'radiusl_multiplier'/
+      data nm(4) /'radiusi_multiplier'/
+      data nm(5) /'u00a'/
+      data nm(6) /'u00b'/
+      data nm(7) /'wmu_multiplier'/
+      data nm(8) /'rwcldox'/
+      data nm(9) /'rimax'/
+      data nm(10) /'mc_fddrt'/
+      data nm(11) /'mc_entr_mass_lim_plume'/
+      data nm(12) /'mc_new_ddrft_thetav'/
+      data nm(13) /'mc_revp_abv_cldbase'/
+      data nm(14) /'ccmul'/
+      data nm(15) /'ccmul2'/
+      data nm(16) /'coetau'/
+      data nm(17) /'wmu'/
+      data nm(18) /'wmul'/
+      data nm(19) /'ti'/
+      data nm(20) /'cldmin'/
+      data nm(21) /'fddet'/
+      data nm(22) /'dtmin1'/
+      data nm(23) /'brcld'/
+      data nm(24) /'lmcm'/
+      data nm(25) /'lm'/
+      data nm(26) /'seconds_per_hour'/
+      integer :: k
+      call ffm_init
+      if (done.ne.0) return
+      done=1
+      if (it0.lt.0) return
+      open(1202,file='ffc_mc_consts.txt',status='replace')
+      do k=1,n
+        write(1202,'(A,1X,ES26.17E3)') trim(nm(k)),v(k)
+      enddo
+      write(1202,'(A,1X,ES26.17E3)') 'dtsrc',dtsrc
+      write(1202,'(A,1X,ES26.17E3)') 'rgas',rgas
+      write(1202,'(A,1X,ES26.17E3)') 'grav',grav
+      write(1202,'(A,1X,ES26.17E3)') 'bygrav',bygrav
+      write(1202,'(A,1X,ES26.17E3)') 'teeny',teeny
+      write(1202,'(A,1X,ES26.17E3)') 'pi',pi
+      write(1202,'(A,1X,ES26.17E3)') 'by3',by3
+      write(1202,'(A,1X,ES26.17E3)') 'by6',by6
+      write(1202,'(A,1X,ES26.17E3)') 'tf',tf
+      write(1202,'(A,1X,ES26.17E3)') 'lhe',lhe
+      write(1202,'(A,1X,ES26.17E3)') 'lhs',lhs
+      write(1202,'(A,1X,ES26.17E3)') 'lhm',lhm
+      write(1202,'(A,1X,ES26.17E3)') 'sha',sha
+      write(1202,'(A,1X,ES26.17E3)') 'bysha',bysha
+      write(1202,'(A,1X,ES26.17E3)') 'deltx',deltx
+      write(1202,'(A,1X,ES26.17E3)') 'mrat',mrat
+      write(1202,'(A,1X,ES26.17E3)') 'rvap',rvap
+      write(1202,'(A,1X,I0)') 'cstride',cstr
+      write(1202,'(A,1X,I0)') 'nstride',nstr
+      write(1202,'(A,1X,I0)') 'ckstride',ckstr
+      close(1202)
+      end subroutine ffm_const
+
+      subroutine ffm_in(i,j,ckon,n,v)
+!@sum full-fidelity-port instrumentation (D110): MSTCNV entry. Stores the
+!@+   packed input vector (layout: clouds_mstcnv_io.IN_FIELDS) and
+!@+   decides whether this call collects stage checkpoints. Files
+!@+   ffc_mc_cols_<itime>.bin (unit 1200) and ffc_mc_ck_<itime>.bin
+!@+   (unit 1201) are opened at the first call of each step.
+      use model_com, only : itime
+      implicit none
+      integer :: i,j,n
+      logical :: ckon
+      real*8 :: v(n)
+      integer :: it0,nst,cstr,nstr,ckstr
+      common /ffm_i/ it0,nst,cstr,nstr,ckstr
+      integer :: act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,ckf
+      common /ffm_j/ act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,
+     &     ckf
+      real*8 :: inb(4000), buf(400000)
+      common /ffm_r/ inb,buf
+      character(len=200) :: fname
+      ckon=.false.
+      call ffm_init
+      act=0
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (n.gt.4000) stop 'ffm_in: n too large'
+      if (itime.ne.curit) then
+        if (curit.ge.0) then
+          close(1200)
+          close(1201)
+        endif
+        curit=itime
+        ncall=0
+        nconv=0
+        nnon=0
+        write(fname,'(A,I0,A)') 'ffc_mc_cols_',itime,'.bin'
+        open(1200,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+        write(fname,'(A,I0,A)') 'ffc_mc_ck_',itime,'.bin'
+        open(1201,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      ncall=ncall+1
+      act=1
+      li=i
+      lj=j
+      nin=n
+      inb(1:n)=v(1:n)
+      nev=0
+      nbuf=0
+      ovf=0
+      ckf=0
+      if (mod(ncall,ckstr).eq.0) ckf=1
+      ckon=(ckf.eq.1)
+      end subroutine ffm_in
+
+      subroutine ffm_ck(stage,lmin,ic,nppl,n,v)
+!@sum full-fidelity-port instrumentation (D110): buffer one checkpoint
+!@+   event (stage,lmin,ic,nppl,n,payload) of the current MSTCNV call.
+      implicit none
+      integer :: stage,lmin,ic,nppl,n
+      real*8 :: v(n)
+      integer :: act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,ckf
+      common /ffm_j/ act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,
+     &     ckf
+      real*8 :: inb(4000), buf(400000)
+      common /ffm_r/ inb,buf
+      if (act.eq.0) return
+      if (nbuf+5+n.gt.400000) then
+        ovf=ovf+1
+        return
+      endif
+      buf(nbuf+1)=dble(stage)
+      buf(nbuf+2)=dble(lmin)
+      buf(nbuf+3)=dble(ic)
+      buf(nbuf+4)=dble(nppl)
+      buf(nbuf+5)=dble(n)
+      buf(nbuf+6:nbuf+5+n)=v(1:n)
+      nbuf=nbuf+5+n
+      nev=nev+1
+      end subroutine ffm_ck
+
+      subroutine ffm_out(n,v)
+!@sum full-fidelity-port instrumentation (D110): MSTCNV exit. Writes the
+!@+   call-boundary record (header 8, IN, OUT) when sampled, and the
+!@+   buffered checkpoint block when the call was convective (LMCMAX>0,
+!@+   OUT field 4) and checkpoint-enabled (such a call always also gets
+!@+   its boundary record, so every checkpoint block has its inputs).
+      use model_com, only : itime
+      implicit none
+      integer :: n
+      real*8 :: v(n)
+      integer :: it0,nst,cstr,nstr,ckstr
+      common /ffm_i/ it0,nst,cstr,nstr,ckstr
+      integer :: act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,ckf
+      common /ffm_j/ act,ncall,curit,nconv,nnon,nev,nbuf,ovf,li,lj,nin,
+     &     ckf
+      real*8 :: inb(4000), buf(400000)
+      common /ffm_r/ inb,buf
+      logical :: conv, wr
+      real*8 :: ckw
+      if (act.eq.0) return
+      act=0
+      conv=(v(4).gt.0.5d0)
+      if (conv) then
+        nconv=nconv+1
+        wr=(mod(nconv,cstr).eq.0)
+      else
+        nnon=nnon+1
+        wr=(mod(nnon,nstr).eq.0)
+      endif
+      ckw=0d0
+      if (conv .and. ckf.eq.1) ckw=1d0
+      if (ckw.gt.0.5d0) wr=.true.
+      if (wr) write(1200) dble(itime),dble(li),dble(lj),dble(ncall),
+     &     merge(1d0,0d0,conv),dble(nin),dble(n),ckw,inb(1:nin),v(1:n)
+      if (ckw.gt.0.5d0) write(1201) dble(itime),dble(li),dble(lj),
+     &     dble(ncall),dble(nev),dble(nbuf),dble(ovf),0d0,buf(1:nbuf)
+      end subroutine ffm_out
