+      subroutine ffdg_rg3(mode,x)
+!@sum D116: regrid_btoa_3d entry (mode 1, saves X) and exit (mode 2,
+!@+   writes), unit 1245, ffd_glue_rg3_<itime>.bin: itime,ncall,site,
+!@+   X_in (im,jm,lm; row 1 undefined), X_out (im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      implicit none
+      integer :: mode
+      real*8 :: x(im,jm,lm)
+      logical, external :: ffdg_on
+      real*8, save :: xin(im,jm,lm)
+      integer :: n,fu,k
+      if (mode.eq.1) then
+        if (ffdg_on()) xin=x
+        return
+      endif
+      call ffdg_st(3,4,n)
+      if (.not.ffdg_on()) return
+      call ffdg_consts()
+      call ffdg_st(4,k,0)
+      fu=1245
+      call ffdg_fn('rg3',fu)
+      write(fu) dble(itime),dble(n),dble(k)
+      write(fu) xin
+      write(fu) x
+      close(fu)
+      end subroutine ffdg_rg3
+
+      subroutine ffdg_kea(kea)
+!@sum D115: calc_kea_3d exit, unit 1244, ffd_glue_kea_<itime>.bin:
+!@+   itime,ncall,site (1 = ATM_DRV step-7 call that fills KEA,
+!@+   2 = the call inside DISSIP), U,V (im,jm,lm), KEA out (im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : u,v
+      implicit none
+      real*8 :: kea(im,jm,lm)
+      logical, external :: ffdg_on
+      integer :: n,fu,k
+      call ffdg_st(2,k,0)
+      call ffdg_st(3,5,n)
+      if (.not.ffdg_on()) return
+      call ffdg_consts()
+      fu=1244
+      call ffdg_fn('kea',fu)
+      write(fu) dble(itime),dble(n),dble(k)
+      write(fu) u(1:im,1:jm,1:lm)
+      write(fu) v(1:im,1:jm,1:lm)
+      write(fu) kea
+      close(fu)
+      end subroutine ffdg_kea
+
+      subroutine ffdg_dissip(mode)
+!@sum D115: DISSIP entry (mode 1: save T) and exit (mode 2: write),
+!@+   unit 1246, ffd_glue_dissip_<itime>.bin: itime,ncall; KEA (saved,
+!@+   im,jm,lm), DKE (= new KE - KEA, im,jm,lm), T_in, T_out (im,jm,
+!@+   lm), PK (lm,im,jm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : t,pk,kea,dke
+      implicit none
+      integer :: mode
+      logical, external :: ffdg_on
+      real*8, save :: tin(im,jm,lm)
+      integer :: n,fu
+      if (mode.eq.1) then
+        if (ffdg_on()) tin=t(1:im,1:jm,1:lm)
+        return
+      endif
+      call ffdg_st(3,6,n)
+      if (.not.ffdg_on()) return
+      call ffdg_consts()
+      fu=1246
+      call ffdg_fn('dissip',fu)
+      write(fu) dble(itime),dble(n)
+      write(fu) kea(1:im,1:jm,1:lm)
+      write(fu) dke(1:im,1:jm,1:lm)
+      write(fu) tin
+      write(fu) t(1:im,1:jm,1:lm)
+      write(fu) pk(1:lm,1:im,1:jm)
+      close(fu)
+      end subroutine ffdg_dissip
