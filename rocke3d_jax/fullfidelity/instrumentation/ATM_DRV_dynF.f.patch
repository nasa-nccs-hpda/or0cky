+      logical function ffdg_on()
+!@sum full-fidelity-port instrumentation (D114-D117): true when env
+!@+   FFD_START/FFD_NSTEP select this itime.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffdg_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffdg_on
+
+      logical function ffdg_en()
+!@sum D117: true when FFD_START is set at all (not window-gated).
+      implicit none
+      integer, save :: init=0
+      logical, save :: en=.false.
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        en = (st.eq.0)
+      endif
+      ffdg_en = en
+      end function ffdg_en
