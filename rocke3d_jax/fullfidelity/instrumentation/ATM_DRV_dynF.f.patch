+      subroutine ffdg_efix(kd,a,b,dse,mmg)
+!@sum D115: energy-fix block of atm_phase1, units 1248, file
+!@+   ffd_glue_efix_<itime>.bin, one record per kd, header itime,
+!@+   kd.  kd 1 (after CONSERV_SE/KE initial): MA (lm,im,jm), U,V,
+!@+   T (im,jm,lm), PK (lm,im,jm), MASUM (im,jm), Q, QCI (im,jm,lm),
+!@+   SEINIT=a, KEINIT=b.
+!@+   kd 2 (after CONSERV_SE/KE final): same inputs, SEFINAL=a,
+!@+   KEFINAL=b (raw).  kd 3 (after the T update): dSEpKE, MMGLOB,
+!@+   SEFINAL=a, KEFINAL=b (combined arrays), T (im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : ma,u,v,t,pk,masum,q,qci
+      implicit none
+      integer :: kd
+      real*8 :: a(im,jm),b(im,jm),dse,mmg
+      logical, external :: ffdg_on
+      integer :: fu
+      if (.not.ffdg_on()) return
+      call ffdg_consts()
+      fu=1248
+      call ffdg_fn('efix',fu)
+      write(fu) dble(itime),dble(kd)
+      if (kd.le.2) then
+        write(fu) ma(1:lm,1:im,1:jm)
+        write(fu) u(1:im,1:jm,1:lm)
+        write(fu) v(1:im,1:jm,1:lm)
+        write(fu) t(1:im,1:jm,1:lm)
+        write(fu) pk(1:lm,1:im,1:jm)
+        write(fu) masum(1:im,1:jm)
+        write(fu) q(1:im,1:jm,1:lm)
+        write(fu) qci(1:im,1:jm,1:lm)
+        write(fu) a
+        write(fu) b
+      else
+        write(fu) dse,mmg
+        write(fu) a
+        write(fu) b
+        write(fu) t(1:im,1:jm,1:lm)
+      endif
+      close(fu)
+      end subroutine ffdg_efix
+
+      subroutine ffdg_daily(mode,end_of_day,deltam,smass,mdryanow,
+     &     mdrya)
+!@sum D117: DAILY_ATMDYN.  Not window-gated (only needs FFD_START to
+!@+   be set).  mode 0 (entry): one text line in
+!@+   ffd_glue_daily_calls.txt (unit 1251): itime itimei end_of_day.
+!@+   mode 1 (just before the MA update): ffd_glue_daily_<itime>.bin
+!@+   unit 1250: itime,1,deltam,smass,mdryanow,mdrya, MA (lm,im,jm),
+!@+   MASUM (im,jm).  mode 2 (after MAtoPMB): itime,2, MA, MASUM,
+!@+   PEDN (lm+1,im,jm).
+      use model_com, only : itime,itimei
+      use resolution, only : im,jm,lm
+      use atm_com, only : ma,masum,pedn
+      implicit none
+      integer :: mode
+      logical :: end_of_day
+      real*8 :: deltam,smass,mdryanow,mdrya
+      logical, external :: ffdg_en
+      integer :: fu
+      if (.not.ffdg_en()) return
+      if (mode.eq.0) then
+        fu=1251
+        open(fu,file='ffd_glue_daily_calls.txt',form='formatted',
+     &       position='append',status='unknown')
+        write(fu,'(2i10,l3)') itime,itimei,end_of_day
+        close(fu)
+        return
+      endif
+      call ffdg_consts()
+      fu=1250
+      call ffdg_fn('daily',fu)
+      write(fu) dble(itime),dble(mode)
+      if (mode.eq.1) write(fu) deltam,smass,mdryanow,mdrya
+      write(fu) ma(1:lm,1:im,1:jm)
+      write(fu) masum(1:im,1:jm)
+      if (mode.eq.2) write(fu) pedn(1:lm+1,1:im,1:jm)
+      close(fu)
+      end subroutine ffdg_daily
+
 
