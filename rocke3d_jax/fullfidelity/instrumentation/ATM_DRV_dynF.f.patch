+      subroutine ffdg_st(mode,k,n)
+!@sum D114-D117: call-site id and per-step call counters.
+!@+   mode 1: set site=k; 2: k=site, site=0; 3: n=++count(k);
+!@+   4: k=site (peek).
+      use model_com, only : itime
+      implicit none
+      integer :: mode,k,n
+      integer, save :: site=0, last=-1, cnt(8)=0
+      if (itime.ne.last) then
+        last=itime
+        cnt(:)=0
+      endif
+      if (mode.eq.1) site=k
+      if (mode.eq.2) then
+        k=site
+        site=0
+      endif
+      if (mode.eq.3) then
+        cnt(k)=cnt(k)+1
+        n=cnt(k)
+      endif
+      if (mode.eq.4) k=site
+      end subroutine ffdg_st
+
+      subroutine ffdg_fn(base,fu)
+!@sum open ffd_glue_<base>_<itime>.bin for appending on unit fu.
+      use model_com, only : itime
+      implicit none
+      character(len=*) :: base
+      integer :: fu
+      character(len=16) :: ts
+      character(len=160) :: fn
+      write(ts,'(i0)') itime
+      fn='ffd_glue_'//trim(base)//'_'//trim(ts)//'.bin'
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     position='append',status='unknown')
+      end subroutine ffdg_fn
+
+      subroutine ffdg_consts()
+!@sum D114-D116: static constants/geometry, written once (unit 1240,
+!@+   ffd_glue_consts.bin).  Layout (doubles): scalars[32] = im,jm,lm,
+!@+   0,grav,rgas,kapa,bykapa,psf,bygrav,sha,dtsrc,byim,mtop,pmtop,
+!@+   areag,lhe,lhm,0*14; JM-arrays bydxp,bydyp,kmaxj,imaxj,dxyp,dxyn,dxys,
+!@+   dxyv,rapvs,rapvn; IM-arrays sinip,cosip,siniv,cosiv; LM-array
+!@+   mfrac; then (im,jm) arrays rapj,idjj,byaxyp,axyp,zatmo and
+!@+   idij(im,im,jm).
+      use constant, only : grav,rgas,kapa,bykapa,bygrav,sha,areag,lhe,
+     &     lhm
+      use resolution, only : im,jm,lm,psf,mtop,pmtop,mfrac
+      use model_com, only : dtsrc
+      use geom, only : bydxp,bydyp,kmaxj,imaxj,dxyp,dxyn,dxys,dxyv,
+     &     rapvs,rapvn,sinip,cosip,siniv,cosiv,rapj,idjj,idij,byaxyp,
+     &     axyp,byim
+      use atm_com, only : zatmo
+      implicit none
+      integer, save :: init=0
+      integer, parameter :: fu=1240
+      if (init.ne.0) return
+      init=1
+      open(fu,file='ffd_glue_consts.bin',form='unformatted',
+     &     access='stream',status='replace')
+      write(fu) dble(im),dble(jm),dble(lm),0d0,grav,rgas,kapa,bykapa,
+     &     psf,bygrav,sha,dtsrc,byim,mtop,pmtop,areag,lhe,lhm,
+     &     0d0,0d0,0d0,0d0,0d0,0d0,
+     &     0d0,0d0,0d0,0d0,0d0,0d0,0d0,0d0
+      write(fu) bydxp(1:jm)
+      write(fu) bydyp(1:jm)
+      write(fu) dble(kmaxj(1:jm))
+      write(fu) dble(imaxj(1:jm))
+      write(fu) dxyp(1:jm)
+      write(fu) dxyn(1:jm)
+      write(fu) dxys(1:jm)
+      write(fu) dxyv(1:jm)
+      write(fu) rapvs(1:jm)
+      write(fu) rapvn(1:jm)
+      write(fu) sinip(1:im)
+      write(fu) cosip(1:im)
+      write(fu) siniv(1:im)
+      write(fu) cosiv(1:im)
+      write(fu) mfrac(1:lm)
+      write(fu) rapj(1:im,1:jm)
+      write(fu) dble(idjj(1:im,1:jm))
+      write(fu) byaxyp(1:im,1:jm)
+      write(fu) axyp(1:im,1:jm)
+      write(fu) zatmo(1:im,1:jm)
+      write(fu) dble(idij(1:im,1:im,1:jm))
+      close(fu)
+      end subroutine ffdg_consts
+
+      subroutine ffdg_trop()
+!@sum D114: CALC_TROP exit, unit 1241, ffd_glue_trop_<itime>.bin:
