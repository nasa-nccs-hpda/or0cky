       return
       end subroutine daily_atm
 
+      logical function ffdd_on()
+!@sum full-fidelity-port instrumentation (D101/D102): true when env
+!@+   FFD_START/FFD_NSTEP select this itime.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffdd_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffdd_on
+
+      subroutine ffdd_consts()
+!@sum D101/D102: static constants/geometry for FILTER, SLP and the
+!@+   energy functions, written once (unit 1120, ffd_filt_consts.bin).
+!@+   Layout (doubles): scalars[32] = im,jm,lm,nmom,cos_limit,dt,
+!@+   mfiltr,0,grav,rgas,sha,kapa,bygrav,bmoist,by3,mb2kg,kg2mb,mtop,
+!@+   mfixs,psf,pmtop,areag,byim,radius,lmfrac1,lmfrac2,0,0,0,0,0,0;
+!@+   JM-arrays cosp,dxp,dxyp,dxyv,rapvs,rapvn,dxyn,dxys,imaxj;
+!@+   LM-arrays mfix,mfrac; IM*JM arrays zatmo,axyp,byaxyp.
+      use constant, only : grav,rgas,sha,kapa,bygrav,bmoist,by3,
+     &     mb2kg,kg2mb,areag,radius
+      use resolution, only : im,jm,lm,mtop,mfixs,mfix,mfrac,psf,pmtop
+      use geom, only : cosp,dxp,dxyp,dxyv,rapvs,rapvn,dxyn,dxys,
+     &     imaxj,axyp,byaxyp,byim
+      use dynamics, only : dt,mfiltr,cos_limit
+      use atm_com, only : zatmo
+      use somtq_com, only : qmom
+      implicit none
+      integer, save :: init=0
+      integer :: l,l1,l2
+      integer, parameter :: fu=1120
+      if (init.ne.0) return
+      init=1
+      do l=1,lm
+        if (mfrac(l).gt.0) exit
+      enddo
+      l1=l
+      do l=lm,1,-1
+        if (mfrac(l).gt.0) exit
+      enddo
+      l2=l
+      open(fu,file='ffd_filt_consts.bin',form='unformatted',
+     &     access='stream',status='replace')
+      write(fu) dble(im),dble(jm),dble(lm),dble(size(qmom,1)),
+     &     cos_limit,dt,dble(mfiltr),0d0,grav,rgas,sha,kapa,bygrav,
+     &     bmoist,by3,mb2kg,kg2mb,mtop,mfixs,psf,pmtop,areag,byim,
+     &     radius,dble(l1),dble(l2),0d0,0d0,0d0,0d0,0d0,0d0
+      write(fu) cosp(1:jm)
+      write(fu) dxp(1:jm)
+      write(fu) dxyp(1:jm)
+      write(fu) dxyv(1:jm)
+      write(fu) rapvs(1:jm)
+      write(fu) rapvn(1:jm)
+      write(fu) dxyn(1:jm)
+      write(fu) dxys(1:jm)
+      write(fu) dble(imaxj(1:jm))
+      write(fu) mfix(1:lm)
+      write(fu) mfrac(1:lm)
+      write(fu) zatmo(1:im,1:jm)
+      write(fu) axyp(1:im,1:jm)
+      write(fu) byaxyp(1:im,1:jm)
+      close(fu)
+      end subroutine ffdd_consts
+
+      subroutine ffdd_fname(base,sfx,fname)
+!@sum D101/D102: file name  base_<itime>_sfx.bin
+      use model_com, only : itime
+      implicit none
+      character(len=*) :: base,sfx
+      character(len=*) :: fname
+      character(len=16) :: ts
+      write(ts,'(i0)') itime
+      fname=trim(base)//trim(ts)//trim(sfx)
+      end subroutine ffdd_fname
+
+      subroutine ffdd_in()
+!@sum D101: FILTER inputs at entry (SLP branch live), unit 1121,
+!@+   ffd_filt_<itime>_in.bin: itime, PEDN(1,:,:) (im,jm), TSAVG
+!@+   (im,jm), MA (lm,im,jm), PK (lm,im,jm), T,Q,QCL,QCI (im,jm,lm),
+!@+   QMOM (nmom,im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : ma,pk,pedn,t,q,qcl,qci
+      use somtq_com, only : qmom
+      use fluxes, only : atmsrf
+      implicit none
+      logical, external :: ffdd_on
+      character(len=128) :: fn
+      integer, parameter :: fu=1121
+      if (.not.ffdd_on()) return
+      call ffdd_consts()
+      call ffdd_fname('ffd_filt_','_in.bin',fn)
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dble(itime)
+      write(fu) pedn(1,1:im,1:jm)
+      write(fu) atmsrf%tsavg(1:im,1:jm)
+      write(fu) ma(1:lm,1:im,1:jm)
+      write(fu) pk(1:lm,1:im,1:jm)
+      write(fu) t(1:im,1:jm,1:lm)
+      write(fu) q(1:im,1:jm,1:lm)
+      write(fu) qcl(1:im,1:jm,1:lm)
+      write(fu) qci(1:im,1:jm,1:lm)
+      write(fu) qmom(:,1:im,1:jm,1:lm)
+      close(fu)
+      end subroutine ffdd_in
+
+      subroutine ffdd_stage(k,x,y)
+!@sum D101: SLP-filter stages, unit 1122, ffd_slp_<itime>.bin:
+!@+   itime, then stage 1 (after the SLP loop): X,Y (im,jm each);
+!@+   2 (after SHAP1D): X; 3 (after isotropslp): X; 4 (after the row
+!@+   loop clip + mass conservation): PEDN(1,:,:).
+      use model_com, only : itime
+      use resolution, only : im,jm
+      use atm_com, only : pedn
+      implicit none
+      integer :: k
+      real*8 :: x(im,jm),y(im,jm)
+      logical, external :: ffdd_on
+      character(len=128) :: fn
+      integer, parameter :: fu=1122
+      if (.not.ffdd_on()) return
+      if (k.eq.1) then
+        call ffdd_fname('ffd_slp_','.bin',fn)
+        open(fu,file=trim(fn),form='unformatted',access='stream',
+     &       status='replace')
+        write(fu) dble(itime)
+        write(fu) x
+        write(fu) y
+      else if (k.eq.4) then
+        write(fu) pedn(1,1:im,1:jm)
+        close(fu)
+      else
+        write(fu) x
+      endif
+      end subroutine ffdd_stage
+
+      subroutine ffdd_out()
+!@sum D101: FILTER outputs after the scaling and the diffuse-heat
+!@+   addition, unit 1123, ffd_filt_<itime>_out.bin: itime,
+!@+   PEDN (lm+1,im,jm), PMID,PK,MA (lm,im,jm), MASUM (im,jm),
+!@+   T,Q,QCL,QCI (im,jm,lm), QMOM (nmom,im,jm,lm).
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : ma,masum,pk,pmid,pedn,t,q,qcl,qci
+      use somtq_com, only : qmom
+      implicit none
+      logical, external :: ffdd_on
+      character(len=128) :: fn
+      integer, parameter :: fu=1123
+      if (.not.ffdd_on()) return
+      call ffdd_fname('ffd_filt_','_out.bin',fn)
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dble(itime)
+      write(fu) pedn(1:lm+1,1:im,1:jm)
+      write(fu) pmid(1:lm,1:im,1:jm)
+      write(fu) pk(1:lm,1:im,1:jm)
+      write(fu) ma(1:lm,1:im,1:jm)
+      write(fu) masum(1:im,1:jm)
+      write(fu) t(1:im,1:jm,1:lm)
+      write(fu) q(1:im,1:jm,1:lm)
+      write(fu) qcl(1:im,1:jm,1:lm)
+      write(fu) qci(1:im,1:jm,1:lm)
+      write(fu) qmom(:,1:im,1:jm,1:lm)
+      close(fu)
+      end subroutine ffdd_out
+
+      subroutine ffdd_ke(rke)
+!@sum D102: CONSERV_KE hook, after the B-grid loop and before
+!@+   REGRID_BtoA_EXT: saves RKE (rows 2..jm valid) for ffdd_te.
+      implicit none
+      real*8 :: rke(72,46)
+      real*8 :: keb(72,46)
+      common /ffddke/ keb
+      logical, external :: ffdd_on
+      if (.not.ffdd_on()) return
+      keb=rke
+      end subroutine ffdd_ke
+
+      subroutine ffdd_te(keij,peij,teij,tot)
+!@sum D102: getTotalEnergy call record, unit 1124,
+!@+   ffd_filt_<itime>_te<n>.bin (n=1 initial, 2 final):
+!@+   itime, n, inputs MASUM (im,jm), MA (lm,im,jm), PK (lm,im,jm),
+!@+   T (im,jm,lm), U (im,jm,lm), V (im,jm,lm); KEB (B-grid KE before
+!@+   regrid, row 1 undefined), KEIJ, PEIJ, TEIJ (im,jm each), TOTAL.
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : ma,masum,pk,t,u,v
+      implicit none
+      real*8 :: keij(72,46),peij(72,46),teij(72,46),tot
+      real*8 :: keb(72,46)
+      common /ffddke/ keb
+      logical, external :: ffdd_on
+      integer, save :: n=0, it=-1
+      character(len=128) :: fn
+      character(len=16) :: sfx
+      integer, parameter :: fu=1124
+      if (.not.ffdd_on()) return
+      if (itime.ne.it) then
+        it=itime
+        n=0
+      endif
+      n=n+1
+      write(sfx,'(a,i0,a)') '_te',n,'.bin'
+      call ffdd_fname('ffd_filt_',trim(sfx),fn)
+      open(fu,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dble(itime),dble(n)
+      write(fu) masum(1:im,1:jm)
+      write(fu) ma(1:lm,1:im,1:jm)
+      write(fu) pk(1:lm,1:im,1:jm)
+      write(fu) t(1:im,1:jm,1:lm)
+      write(fu) u(1:im,1:jm,1:lm)
+      write(fu) v(1:im,1:jm,1:lm)
+      write(fu) keb
+      write(fu) keij
+      write(fu) peij
+      write(fu) teij
+      write(fu) tot
+      close(fu)
+      end subroutine ffdd_te
+
+      subroutine ffdd_eadd(mode,de,ediff)
+!@sum D102: addEnergyAsDiffuseHeat hook, unit 1125,
+!@+   ffd_filt_<itime>_eadd.bin: itime, DELTAENERGY, EDIFF, T_in
+!@+   (im,jm,lm), PK (lm,im,jm), T_out (im,jm,lm).  mode 1 after EDIFF
+!@+   is computed (T still unmodified), mode 2 at the end.
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : pk,t
+      implicit none
+      integer :: mode
+      real*8 :: de,ediff
+      logical, external :: ffdd_on
+      character(len=128) :: fn
+      integer, parameter :: fu=1125
+      if (.not.ffdd_on()) return
+      if (mode.eq.1) then
+        call ffdd_fname('ffd_filt_','_eadd.bin',fn)
+        open(fu,file=trim(fn),form='unformatted',access='stream',
+     &       status='replace')
+        write(fu) dble(itime),de,ediff
+        write(fu) t(1:im,1:jm,1:lm)
+        write(fu) pk(1:lm,1:im,1:jm)
+      else
+        write(fu) t(1:im,1:jm,1:lm)
+        close(fu)
+      endif
+      end subroutine ffdd_eadd
