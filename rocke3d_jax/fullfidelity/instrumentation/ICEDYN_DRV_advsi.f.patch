+
+      subroutine ffadv_open(tag,fu,ok)
+C**** D166 instrumentation: open ffadv_<tag>_<itime>.bin (big-endian stream)
+C**** if itime is in [FFD_START, FFD_START+FFD_NSTEP)
+      use model_com, only : itime
+      implicit none
+      character(len=*) :: tag
+      integer :: fu
+      logical :: ok
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      character(len=200) :: fname
+      ok = .false.
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      write(fname,'(A,A,A,I0,A)') 'ffadv_',trim(tag),'_',itime,'.bin'
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      ok = .true.
+      end subroutine ffadv_open
+
+      subroutine ffadv_w2(fu,im,jm,a)
+      implicit none
+      integer :: fu,im,jm
+      real*8 :: a(im,jm)
+      write(fu) a
+      end subroutine ffadv_w2
+
+      subroutine ffadv_w3(fu,l,im,jm,a)
+      implicit none
+      integer :: fu,l,im,jm
+      real*8 :: a(l,im,jm)
+      write(fu) a
+      end subroutine ffadv_w3
