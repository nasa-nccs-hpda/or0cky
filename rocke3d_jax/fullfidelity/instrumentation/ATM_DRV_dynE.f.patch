+      subroutine ffde_out(rm,rmom,sbf,sbm,sfbm,scf,scm,sfcm,scf3d)
+!@sum AADVQ outputs: ffd_qdyn_<itime>_out.bin = [itime], RM (im,jm,lm),
+!@+   RMOM (9,im,jm,lm) mass units, MMA (im,jm,lm), then the zonal
+!@+   diagnostics SBF,SBM,SFBM,SCF,SCM,SFCM (jm,lm) and SCF3D
+!@+   (im,jm,lm).  Closes the ck stream.
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : mma
+      implicit none
+      real*8 :: rm(im,jm,lm),rmom(9,im,jm,lm)
+      real*8 :: sbf(jm,lm),sbm(jm,lm),sfbm(jm,lm),scf(jm,lm)
+      real*8 :: scm(jm,lm),sfcm(jm,lm),scf3d(im,jm,lm)
+      integer :: fu
+      integer :: ffde_act
+      real*8 :: ffde_sfac
+      character(len=3) :: ffde_comp
+      common /ffdest/ ffde_sfac,ffde_act,ffde_comp
+      save /ffdest/
+      if (ffde_act.eq.0) return
+      close(1141)
+      fu=1143
+      call ffde_open(fu,'out')
+      write(fu) dble(itime)
+      write(fu) rm
+      write(fu) rmom
+      write(fu) mma(1:im,1:jm,1:lm)
+      write(fu) sbf
+      write(fu) sbm
+      write(fu) sfbm
+      write(fu) scf
+      write(fu) scm
+      write(fu) sfcm
+      write(fu) scf3d
+      close(fu)
+      end subroutine ffde_out
