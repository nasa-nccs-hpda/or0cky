+      real*8 :: rm(im,jm,lm),rmom(9,im,jm,lm),mma(im,jm,lm)
+      integer :: fu
+      integer :: ffde_act
+      real*8 :: ffde_sfac
+      character(len=3) :: ffde_comp
+      common /ffdest/ ffde_sfac,ffde_act,ffde_comp
+      save /ffdest/
