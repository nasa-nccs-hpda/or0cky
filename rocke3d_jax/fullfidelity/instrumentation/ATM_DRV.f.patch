+      real*8 :: dtime
+      integer, save :: it0=-1, nst=0, init=0, ncall=0, lastit=-1
+      integer :: st, fu
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (tag.eq.'in') then
+        if (itime.ne.lastit) ncall=0
+        lastit=itime
+        ncall=ncall+1
+      endif
+      if (init.eq.1) then
+        init=2
+        open(989,file='ffa_consts.txt',status='replace')
+        write(989,'(A,ES26.17E3)') 'grav ',grav
+        write(989,'(A,ES26.17E3)') 'rgas ',rgas
+        write(989,'(A,ES26.17E3)') 'deltx ',deltx
+        write(989,'(A,ES26.17E3)') 'teeny ',teeny
+        write(989,'(A,ES26.17E3)') 'sha ',sha
+        write(989,'(A,ES26.17E3)') 'mb2kg ',mb2kg
+        write(989,'(A,ES26.17E3)') 'lhe ',lhe
+        write(989,'(A,ES26.17E3)') 'lhs ',lhs
+        write(989,'(A,ES26.17E3)') 'tf ',tf
+        write(989,'(A,ES26.17E3)') 'mrat ',mrat
+        write(989,'(A,ES26.17E3)') 'rvap ',rvap
+        write(989,'(A,ES26.17E3)') 'stbo ',stbo
+        write(989,'(A,ES26.17E3)') 'shv ',shv
+        write(989,'(A,ES26.17E3)') 'omega2 ',omega2
+        write(989,'(A,ES26.17E3)') 'rhows ',rhows
+        write(989,'(A,ES26.17E3)') 'visc_wtr_kin ',visc_wtr_kin
+        write(989,'(A,ES26.17E3)') 'by3 ',by3
+        write(989,'(A,ES26.17E3)') 'psf ',psf
+        write(989,'(A,ES26.17E3)') 'pmtop ',pmtop
+        write(989,'(A,ES26.17E3)') 'kappa ',kappa
+        write(989,'(A,ES26.17E3)') 'zgs ',zgs
+        write(989,'(A,ES26.17E3)') 'prt ',prt
+        write(989,'(A,ES26.17E3)') 'b1 ',b1
+        write(989,'(A,ES26.17E3)') 'b123 ',b123
+        write(989,'(A,ES26.17E3)') 'd1 ',d1
+        write(989,'(A,ES26.17E3)') 'd2 ',d2
+        write(989,'(A,ES26.17E3)') 'd3 ',d3
+        write(989,'(A,ES26.17E3)') 'd4 ',d4
+        write(989,'(A,ES26.17E3)') 'd5 ',d5
+        write(989,'(A,ES26.17E3)') 's0 ',s0
+        write(989,'(A,ES26.17E3)') 's1 ',s1
+        write(989,'(A,ES26.17E3)') 's2 ',s2
+        write(989,'(A,ES26.17E3)') 's4 ',s4
+        write(989,'(A,ES26.17E3)') 's5 ',s5
+        write(989,'(A,ES26.17E3)') 's6 ',s6
+        write(989,'(A,ES26.17E3)') 's7 ',s7
+        write(989,'(A,ES26.17E3)') 's8 ',s8
+        write(989,'(A,ES26.17E3)') 'c1 ',c1
+        write(989,'(A,ES26.17E3)') 'c2 ',c2
+        write(989,'(A,ES26.17E3)') 'c3 ',c3
+        write(989,'(A,ES26.17E3)') 'c4 ',c4
+        write(989,'(A,ES26.17E3)') 'c5 ',c5
+        write(989,'(A,ES26.17E3)') 'rimax ',rimax
+        write(989,'(A,ES26.17E3)') 'gm_at_rimax ',gm_at_rimax
+        write(989,'(A,ES26.17E3)') 'ghmin ',ghmin
+        write(989,'(A,ES26.17E3)') 'ghmax ',ghmax
+        write(989,'(A,ES26.17E3)') 'emin ',emin
+        write(989,'(A,ES26.17E3)') 'emax ',emax
+        write(989,'(A,ES26.17E3)') 'k_max ',k_max
+        write(989,'(A,ES26.17E3)') 'kmmin ',kmmin
+        write(989,'(A,ES26.17E3)') 'khmin ',khmin
+        write(989,'(A,ES26.17E3)') 'ustar_min ',ustar_min
+        write(989,'(A,ES26.17E3)') 'lmonin_min ',lmonin_min
+        write(989,'(A,ES26.17E3)') 'lmonin_max ',lmonin_max
+        close(989)
+        open(990,file='ffa_geom.txt',status='replace')
+        write(990,'(A,2I6)') 'im_jm ',im,jm
+        write(990,'(A)') 'rapvs'
+        write(990,'(ES26.17E3)') rapvs(1:jm)
+        write(990,'(A)') 'rapvn'
+        write(990,'(ES26.17E3)') rapvn(1:jm)
+        write(990,'(A)') 'ravps'
+        write(990,'(ES26.17E3)') ravps(1:jm)
+        write(990,'(A)') 'ravpn'
+        write(990,'(ES26.17E3)') ravpn(1:jm)
+        write(990,'(A)') 'dxyp'
+        write(990,'(ES26.17E3)') dxyp(1:jm)
+        write(990,'(A)') 'dxys'
+        write(990,'(ES26.17E3)') dxys(1:jm)
+        write(990,'(A)') 'dxyn'
+        write(990,'(ES26.17E3)') dxyn(1:jm)
+        write(990,'(A)') 'dxyv'
+        write(990,'(ES26.17E3)') dxyv(1:jm)
+        write(990,'(A)') 'cosiv'
+        write(990,'(ES26.17E3)') cosiv(1:im)
+        write(990,'(A)') 'siniv'
+        write(990,'(ES26.17E3)') siniv(1:im)
+        write(990,'(A)') 'rapj_pole_s'
+        write(990,'(ES26.17E3)') rapj(1:im,1)
+        write(990,'(A)') 'rapj_mid'
+        write(990,'(ES26.17E3)') rapj(1:4,2)
+        close(990)
+      endif
+      write(fname,'(A,I0,A,I0,A,A,A)') 'ffa_',itime,'_c',ncall,'_',
+     &     trim(tag),'.bin'
+      fu=988
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dtime
+      call w3('U',u)
+      call w3('V',v)
+      call w3('T',t)
+      call w3('Q',q)
+      call w3('UALIJ',ualij)
+      call w3('VALIJ',valij)
+      call w3('EGCM',egcm)
+      call w3('W2GCM',w2gcm)
+      call w3('MA',ma)
+      call w3('PK',pk)
+      call w3('PEK',pek)
+      call w3('PMID',pmid)
+      call w3('PEDN',pedn)
+      call w3('PDSIG',pdsig)
+      call w2('UFLUX1',uflux1)
+      call w2('VFLUX1',vflux1)
+      call w2('TFLUX1',tflux1)
+      call w2('QFLUX1',qflux1)
+      call w2('TSAVG',atmsrf%tsavg)
+      call w2('QSAVG',atmsrf%qsavg)
+      call w2('PBLHT',pblht)
+      call w2('DCLEV',dclev)
+      call w2('PBLPTOP',pblptop)
+      close(fu)
+      contains
+      subroutine w3(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 3, lbound(a,1),lbound(a,2),lbound(a,3),
+     &     ubound(a,1),ubound(a,2),ubound(a,3)
+      write(fu) a
+      end subroutine w3
+      subroutine w2(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 2, lbound(a,1),lbound(a,2),1,
+     &     ubound(a,1),ubound(a,2),1
+      write(fu) a
+      end subroutine w2
+      end subroutine ffdump_aturb
