+      subroutine ffdump(tag)
+!@sum full-fidelity-port instrumentation: write prognostic state
+!@+   to stream files when env FFD_START/FFD_NSTEP select this itime
+      use model_com, only : itime
+      use atm_com, only : ma,u,v,t,q,qcl,qci,p,pk,pmid,pedn,pdsig
+      implicit none
+      character(len=*) :: tag
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st, fu
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      write(fname,'(A,I0,A,A,A)') 'ffd_',itime,'_',trim(tag),'.bin'
+      fu=987
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      call ffw3('MA',ma)
+      call ffw3('U',u)
+      call ffw3('V',v)
+      call ffw3('T',t)
+      call ffw3('Q',q)
+      call ffw3('QCL',qcl)
+      call ffw3('QCI',qci)
+      call ffw3('PK',pk)
+      call ffw3('PMID',pmid)
+      call ffw3('PEDN',pedn)
+      call ffw3('PDSIG',pdsig)
+      call ffw2('P',p)
+      close(fu)
+      contains
+      subroutine ffw3(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 3, lbound(a,1),lbound(a,2),lbound(a,3),
+     &     ubound(a,1),ubound(a,2),ubound(a,3)
+      write(fu) a
+      end subroutine ffw3
+      subroutine ffw2(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 2, lbound(a,1),lbound(a,2),1,
+     &     ubound(a,1),ubound(a,2),1
+      write(fu) a
+      end subroutine ffw2
+      end subroutine ffdump
+
+      subroutine ffdump_aturb(tag,dtime)
+!@sum full-fidelity-port instrumentation for ATURB (atm_diffus)
+      use model_com, only : itime
+      use constant, only : grav,rgas,deltx,teeny,sha,mb2kg,lhe,by3,
+     &     tf,stbo,shv,lhs,omega2,rhows,visc_wtr_kin,mrat,rvap
+      use resolution, only : psf,pmtop,im,jm
+      use geom, only : rapvs,rapvn,ravps,ravpn,cosiv,siniv,dxyp,dxys,
+     &     dxyn,dxyv,rapj
+      use socpbl, only : kappa,zgs,prt,b1,b123,d1,d2,d3,d4,d5,
+     &     s0,s1,s2,s4,s5,s6,s7,s8,c1,c2,c3,c4,c5,rimax,gm_at_rimax,
+     &     ghmin,ghmax,emin,emax,k_max,kmmin,khmin,ustar_min,
+     &     lmonin_min,lmonin_max
