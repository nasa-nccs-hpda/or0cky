+      subroutine ffdump(tag)
+!@sum full-fidelity-port instrumentation: write prognostic state
+!@+   to stream files when env FFD_START/FFD_NSTEP select this itime
+      use model_com, only : itime
+      use atm_com, only : ma,u,v,t,q,qcl,qci,p,pk,pmid,pedn,pdsig
+      implicit none
+      character(len=*) :: tag
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st, fu
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      write(fname,'(A,I0,A,A,A)') 'ffd_',itime,'_',trim(tag),'.bin'
+      fu=987
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      call ffw3('MA',ma)
+      call ffw3('U',u)
+      call ffw3('V',v)
+      call ffw3('T',t)
+      call ffw3('Q',q)
+      call ffw3('QCL',qcl)
+      call ffw3('QCI',qci)
+      call ffw3('PK',pk)
+      call ffw3('PMID',pmid)
+      call ffw3('PEDN',pedn)
+      call ffw3('PDSIG',pdsig)
+      call ffw2('P',p)
+      close(fu)
+      contains
+      subroutine ffw3(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 3, lbound(a,1),lbound(a,2),lbound(a,3),
+     &     ubound(a,1),ubound(a,2),ubound(a,3)
+      write(fu) a
+      end subroutine ffw3
+      subroutine ffw2(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 2, lbound(a,1),lbound(a,2),1,
+     &     ubound(a,1),ubound(a,2),1
+      write(fu) a
+      end subroutine ffw2
+      end subroutine ffdump
+
+      subroutine ffdump_aturb(tag,dtime)
+!@sum full-fidelity-port instrumentation for ATURB (atm_diffus)
+      use model_com, only : itime
+      use atm_com, only : ma,u,v,t,q,pk,pek,pmid,pedn,pdsig,ualij,valij
+      use pblcom, only : egcm,w2gcm,pblht,dclev,pblptop
+      use fluxes, only : uflux1,vflux1,tflux1,qflux1,atmsrf
+      implicit none
+      character(len=*) :: tag
+      real*8 :: dtime
+      integer, save :: it0=-1, nst=0, init=0, ncall=0, lastit=-1
+      integer :: st, fu
+      character(len=64) :: buf
+      character(len=200) :: fname
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (tag.eq.'in') then
+        if (itime.ne.lastit) ncall=0
+        lastit=itime
+        ncall=ncall+1
+      endif
+      write(fname,'(A,I0,A,I0,A,A,A)') 'ffa_',itime,'_c',ncall,'_',
+     &     trim(tag),'.bin'
+      fu=988
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      write(fu) dtime
+      call w3('U',u)
+      call w3('V',v)
+      call w3('T',t)
+      call w3('Q',q)
+      call w3('UALIJ',ualij)
+      call w3('VALIJ',valij)
+      call w3('EGCM',egcm)
+      call w3('W2GCM',w2gcm)
+      call w3('MA',ma)
+      call w3('PK',pk)
+      call w3('PEK',pek)
+      call w3('PMID',pmid)
+      call w3('PEDN',pedn)
+      call w3('PDSIG',pdsig)
+      call w2('UFLUX1',uflux1)
+      call w2('VFLUX1',vflux1)
+      call w2('TFLUX1',tflux1)
+      call w2('QFLUX1',qflux1)
+      call w2('TSAVG',atmsrf%tsavg)
+      call w2('QSAVG',atmsrf%qsavg)
+      call w2('PBLHT',pblht)
+      call w2('DCLEV',dclev)
+      call w2('PBLPTOP',pblptop)
+      close(fu)
+      contains
+      subroutine w3(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 3, lbound(a,1),lbound(a,2),lbound(a,3),
+     &     ubound(a,1),ubound(a,2),ubound(a,3)
+      write(fu) a
+      end subroutine w3
+      subroutine w2(nm,a)
+      character(len=*) :: nm
+      real*8 :: a(:,:)
+      character(len=16) :: nm16
+      nm16=nm
+      write(fu) nm16, 2, lbound(a,1),lbound(a,2),1,
+     &     ubound(a,1),ubound(a,2),1
+      write(fu) a
+      end subroutine w2
+      end subroutine ffdump_aturb
