+      subroutine ffdump_dq(kind,sm,qm,plk,mass,lhx,pl,cond,dqsum,f)
+!@sum full-fidelity-port instrumentation (D89): one 13-double record
+!@+   per sampled call of get_dq_cond (kind=1) / get_dq_evap (kind=2).
+!@+   Record: itime,site,kind,ncall,sm,qm,plk,mass,lhx,pl,cond,dqsum,f
+!@+   (cond=0 for kind 1). Every FFC_DQ_STRIDE-th call (default 10)
+!@+   of each (itime,site) is recorded (ncall counts all calls, from
+!@+   1, so records have ncall = k*stride). Single thread assumed.
+!@+   File ffc_dq_<itime>.bin, unit 1050. Constants -> ffc_dq_consts.txt
+      use model_com, only : itime
+      use constant, only : bysha,mrat,rvap,tf,lhe,lhs
+      implicit none
+      integer :: kind
+      real*8 :: sm,qm,plk,mass,lhx,pl,cond,dqsum,f
+      integer :: ffdq_cur
+      common /ffdqsite/ ffdq_cur
+      integer, save :: it0=-1, nst=0, init=0, stride=10
+      integer, save :: lastit=-1, ncall(6)=0
+      integer :: st, fu, s
+      character(len=64) :: buf
+      character(len=200) :: fname
+      fu=1050
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+        call get_environment_variable('FFC_DQ_STRIDE',buf,status=st)
+        if (st.eq.0) read(buf,*) stride
+        if (it0.ge.0) then
+          open(fu,file='ffc_dq_consts.txt',status='replace')
+          write(fu,'(A,ES26.17E3)') 'bysha ',bysha
+          write(fu,'(A,ES26.17E3)') 'mrat ',mrat
+          write(fu,'(A,ES26.17E3)') 'rvap ',rvap
+          write(fu,'(A,ES26.17E3)') 'tf ',tf
+          write(fu,'(A,ES26.17E3)') 'lhe ',lhe
+          write(fu,'(A,ES26.17E3)') 'lhs ',lhs
+          write(fu,'(A,I0)') 'stride ',stride
+          close(fu)
+        endif
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (itime.ne.lastit) then
+        if (lastit.ge.0) close(fu)
+        lastit=itime
+        ncall=0
+        write(fname,'(A,I0,A)') 'ffc_dq_',itime,'.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      s=ffdq_cur
+      if (s.lt.1 .or. s.gt.6) s=0
+      if (s.eq.0) return
+      ncall(s)=ncall(s)+1
+      if (mod(ncall(s),stride).ne.0) return
+      write(fu) dble(itime),dble(s),dble(kind),dble(ncall(s)),
+     &     sm,qm,plk,mass,lhx,pl,cond,dqsum,f
+      end subroutine ffdump_dq
+
