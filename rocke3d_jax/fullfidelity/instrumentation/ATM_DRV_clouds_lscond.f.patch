+      subroutine ffls_want(rt,i,j,on)
+!@sum full-fidelity-port instrumentation (D107-D109): decide whether
+!@+   the current LSCOND column call is sampled. rt=1: boundary and
+!@+   post-main-loop records (stride FFC_LS_STRIDE_B, default 10);
+!@+   rt=2: size/optical-thickness tail records (stride
+!@+   FFC_LS_STRIDE_T, default 4). A call is sampled when
+!@+   mod(ncall+(itime-FFD_START),stride)==0, ncall = running count of
+!@+   the LSCOND calls of the step for that rt (so a different column
+!@+   subset is taken every step). Single thread assumed.
+      use model_com, only : itime,dtsrc
+      use constant, only : rgas,grav,teeny,pi,by3,twopi,lhe,lhs,lhm,
+     &     tf,sha,bysha,deltx,mrat,rvap,bygrav,bymrat
+      implicit none
+      integer :: rt,i,j,on
+      integer, save :: it0=-1, nst=0, init=0
+      integer, save :: stride(2)=(/10,4/)
+      integer, save :: curit(2)=-1, ncall(2)=0
+      integer :: li(2), lj(2), lnc(2)
+      common /ffls_w/ li,lj,lnc
+      real*8 :: buf(20000), stash(20000,2)
+      integer :: np, ns(2)
+      common /ffls_r/ buf, stash
+      common /ffls_i/ np, ns
+      integer :: st
+      character(len=64) :: cbuf
+      on=0
+      if (init.eq.0) then
+        init=1
+        np=0
+        ns=0
+        li=0
+        lj=0
+        lnc=0
+        call get_environment_variable('FFD_START',cbuf,status=st)
+        if (st.eq.0) read(cbuf,*) it0
+        call get_environment_variable('FFD_NSTEP',cbuf,status=st)
+        if (st.eq.0) read(cbuf,*) nst
+        call get_environment_variable('FFC_LS_STRIDE_B',cbuf,status=st)
+        if (st.eq.0) read(cbuf,*) stride(1)
+        call get_environment_variable('FFC_LS_STRIDE_T',cbuf,status=st)
+        if (st.eq.0) read(cbuf,*) stride(2)
+        if (it0.ge.0) then
+          open(1173,file='ffc_ls_consts.txt',status='replace')
+          write(1173,'(A,ES26.17E3)') 'dtsrc ',dtsrc
+          write(1173,'(A,ES26.17E3)') 'rgas ',rgas
+          write(1173,'(A,ES26.17E3)') 'grav ',grav
+          write(1173,'(A,ES26.17E3)') 'bygrav ',bygrav
+          write(1173,'(A,ES26.17E3)') 'teeny ',teeny
+          write(1173,'(A,ES26.17E3)') 'pi ',pi
+          write(1173,'(A,ES26.17E3)') 'by3 ',by3
+          write(1173,'(A,ES26.17E3)') 'twopi ',twopi
+          write(1173,'(A,ES26.17E3)') 'lhe ',lhe
+          write(1173,'(A,ES26.17E3)') 'lhs ',lhs
+          write(1173,'(A,ES26.17E3)') 'lhm ',lhm
+          write(1173,'(A,ES26.17E3)') 'tf ',tf
+          write(1173,'(A,ES26.17E3)') 'sha ',sha
+          write(1173,'(A,ES26.17E3)') 'bysha ',bysha
+          write(1173,'(A,ES26.17E3)') 'deltx ',deltx
+          write(1173,'(A,ES26.17E3)') 'mrat ',mrat
+          write(1173,'(A,ES26.17E3)') 'bymrat ',bymrat
+          write(1173,'(A,ES26.17E3)') 'rvap ',rvap
+          write(1173,'(A,I0)') 'stride_b ',stride(1)
+          write(1173,'(A,I0)') 'stride_t ',stride(2)
+          close(1173)
+        endif
+      endif
+      if (it0.lt.0) return
+      if (itime.lt.it0 .or. itime.ge.it0+nst) return
+      if (rt.lt.1 .or. rt.gt.2) return
+      if (itime.ne.curit(rt)) then
+        curit(rt)=itime
+        ncall(rt)=0
+      endif
+      ncall(rt)=ncall(rt)+1
+      li(rt)=i
+      lj(rt)=j
+      lnc(rt)=ncall(rt)
+      if (mod(ncall(rt)+(itime-it0),stride(rt)).eq.0) on=1
+      return
+      end subroutine ffls_want
+
+      subroutine ffls_put(a,n)
+!@sum D107-D109: append n doubles to the current record buffer
+      implicit none
+      integer :: n
+      real*8 :: a(n)
+      real*8 :: buf(20000), stash(20000,2)
+      integer :: np, ns(2)
+      common /ffls_r/ buf, stash
+      common /ffls_i/ np, ns
+      if (np+n.gt.20000) stop 'ffls_put overflow'
+      buf(np+1:np+n)=a(1:n)
+      np=np+n
+      end subroutine ffls_put
+
+      subroutine ffls_put1(x)
+!@sum D107-D109: append one double to the current record buffer
+      implicit none
+      real*8 :: x
+      real*8 :: a(1)
+      a(1)=x
+      call ffls_put(a,1)
+      end subroutine ffls_put1
+
+      subroutine ffls_stash(k)
+!@sum D107-D109: move the current buffer to stash slot k, clear it
+      implicit none
+      integer :: k
+      real*8 :: buf(20000), stash(20000,2)
+      integer :: np, ns(2)
+      common /ffls_r/ buf, stash
+      common /ffls_i/ np, ns
+      stash(1:np,k)=buf(1:np)
+      ns(k)=np
+      np=0
+      end subroutine ffls_stash
+
+      subroutine ffls_flush(kind,k)
+!@sum D107-D109: write one record = header(6) + stash(k) (if k>0) +
+!@+   current buffer. Header: itime,kind,ncall,i,j,nbody. kind 1 bnd
+!@+   (unit 1170, ffc_ls_bnd_<itime>.bin), 2 mid (1171, ffc_ls_mid_),
+!@+   3 tail (1172, ffc_ls_tail_). Big-endian f8 stream.
+      use model_com, only : itime
+      implicit none
+      integer :: kind,k
+      real*8 :: buf(20000), stash(20000,2)
+      integer :: np, ns(2)
+      common /ffls_r/ buf, stash
+      common /ffls_i/ np, ns
+      integer :: li(2),lj(2),lnc(2)
+      common /ffls_w/ li,lj,lnc
+      integer, save :: fit(3)=-1
+      character(len=8), save :: nm(3)=(/'bnd ','mid ','tail'/)
+      character(len=200) :: fname
+      integer :: fu,rt,nb
+      fu=1169+kind
+      rt=1
+      if (kind.eq.3) rt=2
+      nb=np
+      if (k.gt.0) nb=nb+ns(k)
+      if (itime.ne.fit(kind)) then
+        if (fit(kind).ge.0) close(fu)
+        fit(kind)=itime
+        write(fname,'(A,A,A,I0,A)') 'ffc_ls_',trim(nm(kind)),'_',
+     &       itime,'.bin'
+        open(fu,file=trim(fname),form='unformatted',access='stream',
+     &       status='replace')
+      endif
+      write(fu) dble(itime),dble(kind),dble(lnc(rt)),dble(li(rt)),
+     &     dble(lj(rt)),dble(nb)
+      if (k.gt.0) write(fu) stash(1:ns(k),k)
+      write(fu) buf(1:np)
+      np=0
+      end subroutine ffls_flush
+
+
 
