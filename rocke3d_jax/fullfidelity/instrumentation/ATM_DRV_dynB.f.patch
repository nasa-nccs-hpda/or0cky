+      logical function ffdb_on()
+!@sum full-fidelity-port instrumentation (D96-D98): true when env
+!@+   FFD_START/FFD_NSTEP select this itime.  Units 1081-1085.
+      use model_com, only : itime
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFD_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFD_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      ffdb_on = .not.(it0.lt.0 .or. itime.lt.it0
+     &     .or. itime.ge.it0+nst)
+      end function ffdb_on
+
+      subroutine ffdb_pass_inc()
+!@sum D96: count AFLUX entries within one DYNAM call (= leapfrog pass
+!@+   index 1..5: 1 fwd(MRCH=0), 2 bwd(-1), 3 even(2), 4 odd(-2), 5 even(2)).
+!@+   Reset whenever itime changes.
+      use model_com, only : itime
+      implicit none
+      integer :: ffdb_last,ffdb_np
+      common /ffdbpass/ ffdb_last,ffdb_np
+      save /ffdbpass/
+      integer, save :: init=0
+      if (init.eq.0) then
+        init=1
+        ffdb_last=-1
+        ffdb_np=0
+      endif
+      if (itime.ne.ffdb_last) then
+        ffdb_last=itime
+        ffdb_np=0
+      endif
+      ffdb_np=ffdb_np+1
+      end subroutine ffdb_pass_inc
+
+      subroutine ffdb_open(fu,tag,rt,ph)
+      use model_com, only : itime
+      implicit none
+      integer :: fu
+      character(len=*) :: tag,ph
+      character(len=*) :: rt
+      character(len=200) :: fname
+      integer :: ffdb_last,ffdb_np
+      common /ffdbpass/ ffdb_last,ffdb_np
+      save /ffdbpass/
+      write(fname,'(A,A,I0,A,I0,A,A,A)') 'ffd_',trim(tag),itime,'_p',
+     &     ffdb_np,'_',trim(ph),'.bin'
+      open(fu,file=trim(fname),form='unformatted',access='stream',
+     &     status='replace')
+      end subroutine ffdb_open
