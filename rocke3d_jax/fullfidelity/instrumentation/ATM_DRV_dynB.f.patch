+      subroutine ffdb_geom(naflux,aftopo,np,ip,jp,md)
+!@sum D96: static geometry/constants for AFLUX/ADVECM/MAtoP/PGF/ADVECV
+!@+   written once (unit 1083, ffd_aflux_geom.bin).  Layout (doubles):
+!@+   scalars[32], then JM-arrays (dxyp,bydxyp,dyp,bydyp,dxp,dxv,dyv,
+!@+   dxyv,dxyn,dxys,ravpn,ravps,rapvn,rapvs,fcor,cosv,imaxj),
+!@+   IM-arrays (siniv,cosiv), LM-arrays (mfix,mfrac), zatmo(IM,JM),
+!@+   ipatch(2,np),jpatch(2,np),md(np).
+      use constant, only : grav,rgas,kapa,bygrav,bykapa,bykapap1,
+     &     bykapap2,kg2mb,sha,radius,omega
+      use resolution, only : im,jm,lm,mtop,mfixs,mfix,mfrac,mdrya
+      use geom, only : dxyp,bydxyp,dyp,bydyp,dxp,dxv,dyv,dxyv,dxyn,
+     &     dxys,ravpn,ravps,rapvn,rapvs,fcor,cosv,imaxj,siniv,cosiv,
+     &     acor,acor2,polwt,dlon,byim
+      use dynamics, only : dt,mincolmass,maxcolmass,do_polefix,nidyn
+      use atm_com, only : zatmo
+      implicit none
+      logical :: aftopo
+      integer :: naflux,np
+      integer :: ip(2,np),jp(2,np),md(np)
+      integer, save :: init=0
+      integer :: fu
+      if (init.ne.0) return
+      init=1
+      fu=1083
+      open(fu,file='ffd_aflux_geom.bin',form='unformatted',
+     &     access='stream',status='replace')
+      write(fu) dble(im),dble(jm),dble(lm),grav,rgas,kapa,bygrav,
+     &     bykapa,bykapap1,bykapap2,kg2mb,mtop,mfixs,mincolmass,
+     &     maxcolmass,dt,dlon,byim,dble(do_polefix),dble(nidyn),
+     &     merge(1d0,0d0,aftopo),dble(np),polwt,acor,acor2,mdrya,sha,
+     &     radius,omega,0d0,0d0,0d0
+      write(fu) dxyp(1:jm)
+      write(fu) bydxyp(1:jm)
+      write(fu) dyp(1:jm)
+      write(fu) bydyp(1:jm)
+      write(fu) dxp(1:jm)
+      write(fu) dxv(1:jm)
+      write(fu) dyv(1:jm)
+      write(fu) dxyv(1:jm)
+      write(fu) dxyn(1:jm)
+      write(fu) dxys(1:jm)
+      write(fu) ravpn(1:jm)
+      write(fu) ravps(1:jm)
+      write(fu) rapvn(1:jm)
+      write(fu) rapvs(1:jm)
+      write(fu) fcor(1:jm)
+      write(fu) cosv(1:jm)
+      write(fu) dble(imaxj(1:jm))
+      write(fu) siniv(1:im)
+      write(fu) cosiv(1:im)
+      write(fu) mfix(1:lm)
+      write(fu) mfrac(1:lm)
+      write(fu) zatmo(1:im,1:jm)
+      write(fu) dble(ip)
+      write(fu) dble(jp)
+      write(fu) dble(md)
+      close(fu)
+      end subroutine ffdb_geom
+
+      subroutine ffdb_aflux_in(ns,im,jm,lm,u,v,ma,masum,me,mesum,
+     &     aftopo,np,ip,jp,md)
+!@sum D96: AFLUX inputs (unit 1081): ffd_aflux_<itime>_p<k>_in.bin =
+!@+   [itime,pass,NS,DT,MRCH], U,V (im,jm,lm), MA (lm,im,jm), MASUM
+!@+   (im,jm), ME (lm,im,jm), MESUM (im,jm).
+      use model_com, only : itime
+      use dynamics, only : dt,mrch
+      implicit none
+      integer :: ns,im,jm,lm,np
+      real*8 :: u(im,jm,lm),v(im,jm,lm),ma(lm,im,jm),masum(im,jm),
+     &     me(lm,im,jm),mesum(im,jm)
+      logical :: aftopo
+      integer :: ip(2,np),jp(2,np),md(np)
+      logical, external :: ffdb_on
+      integer :: fu
+      integer :: ffdb_last,ffdb_np
+      common /ffdbpass/ ffdb_last,ffdb_np
+      save /ffdbpass/
+      if (.not.ffdb_on()) return
+      call ffdb_geom(0,aftopo,np,ip,jp,md)
+      fu=1081
+      call ffdb_open(fu,'aflux_','','in')
+      write(fu) dble(itime),dble(ffdb_np),dble(ns),dt,dble(mrch)
+      write(fu) u
+      write(fu) v
+      write(fu) ma
+      write(fu) masum
+      write(fu) me
+      write(fu) mesum
+      close(fu)
+      end subroutine ffdb_aflux_in
+
+      subroutine ffdb_aflux_out(im,jm,lm,spa0)
+!@sum D96: AFLUX outputs: [itime,pass], MU,MV (im,jm,lm), MW (im,jm,lm-1),
+!@+   CONV, SPA (post AVRX), SPA0 (SPA before AVRX; rows 2..JM-1 only, 0 elsewhere).
+      use model_com, only : itime
+      use dynamics, only : mu,mv,mw,conv,spa
+      implicit none
+      integer :: im,jm,lm
+      real*8 :: spa0(im,jm,lm)
+      logical, external :: ffdb_on
+      integer :: fu
+      integer :: ffdb_last,ffdb_np
+      common /ffdbpass/ ffdb_last,ffdb_np
+      save /ffdbpass/
+      if (.not.ffdb_on()) return
+      fu=1081
+      call ffdb_open(fu,'aflux_','','out')
+      write(fu) dble(itime),dble(ffdb_np)
+      write(fu) mu(1:im,1:jm,1:lm)
+      write(fu) mv(1:im,1:jm,1:lm)
+      write(fu) mw(1:im,1:jm,1:lm-1)
+      write(fu) conv(1:im,1:jm,1:lm)
+      write(fu) spa(1:im,1:jm,1:lm)
+      write(fu) spa0
+      close(fu)
+      end subroutine ffdb_aflux_out
