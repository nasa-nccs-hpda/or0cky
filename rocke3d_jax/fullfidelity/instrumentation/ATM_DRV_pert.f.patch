+      subroutine ffpt_perturb
+!@sum D151: one-ulp perturbation of T or Q at one point, applied once
+!@+   at atm_phase1 entry of itime=FFPT_START. env FFPT_PERT='T i j l s'
+!@+   (field T or Q, 1-based indices, s=+1/-1 direction: nearest()).
+!@+   No-op when FFPT_PERT or FFPT_START is unset.
+      use model_com, only : itime
+      use atm_com, only : t,q
+      implicit none
+      integer, save :: it0=-1, init=0, done=0
+      integer :: st,i,j,l
+      real*8 :: s,old
+      character(len=64) :: buf
+      character(len=8) :: fld
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFPT_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+      endif
+      if (done.eq.1 .or. it0.lt.0 .or. itime.ne.it0) return
+      done=1
+      call get_environment_variable('FFPT_PERT',buf,status=st)
+      if (st.ne.0) return
+      read(buf,*) fld,i,j,l,s
+      if (i.le.0) then
+!       whole-field mode: +-1 ulp (checkerboard sign) on all cells of
+!       level l (all levels when l<=0), field T or Q
+        call ffpt_all(fld(1:1),j,s)
+        return
+      endif
+      if (fld(1:1).eq.'T') then
+        old=t(i,j,l)
+        t(i,j,l)=nearest(old,s)
+        write(6,*) 'FFPT perturbed T',i,j,l,old,t(i,j,l)
+      else
+        old=q(i,j,l)
+        q(i,j,l)=nearest(old,s)
+        write(6,*) 'FFPT perturbed Q',i,j,l,old,q(i,j,l)
+      endif
+      end subroutine ffpt_perturb
+
+      subroutine ffpt_all(fld,lev,s)
+      use resolution, only : im,jm,lm
+      use atm_com, only : t,q
+      implicit none
+      character(len=1) :: fld
+      integer :: lev,i,j,l
+      real*8 :: s,sg
+      do l=1,lm
+      if (lev.gt.0 .and. l.ne.lev) cycle
+      do j=1,jm
+      do i=1,im
+        sg=s*dble(1-2*mod(i+j+l,2))
+        if (fld.eq.'T') then
+          t(i,j,l)=nearest(t(i,j,l),sg)
+        else
+          q(i,j,l)=nearest(q(i,j,l),sg)
+        endif
+      enddo
+      enddo
+      enddo
+      write(6,*) 'FFPT perturbed whole field ',fld,' level',lev
+      end subroutine ffpt_all
+
+      subroutine ffpt_dump
+!@sum D151: small per-step end-state dump (U V T Q QCL QCI P) at the
+!@+   end of atm_phase2 (same place as ffas site e), unit 1410, file
+!@+   ffpt_<FFPT_TAG>_<itime>.bin (big-endian float64 stream, records:
+!@+   char*16 name, int32 rank, int32 n(1:4), data). Window env
+!@+   FFPT_START/FFPT_NSTEP.
+      use model_com, only : itime
+      use resolution, only : im,jm,lm
+      use atm_com, only : u,v,t,q,qcl,qci,p
+      implicit none
+      integer, save :: it0=-1, nst=0, init=0
+      integer :: st
+      character(len=64) :: buf
+      character(len=16) :: ts
+      character(len=64) :: tag
+      character(len=200) :: fn
+      if (init.eq.0) then
+        init=1
+        call get_environment_variable('FFPT_START',buf,status=st)
+        if (st.eq.0) read(buf,*) it0
+        call get_environment_variable('FFPT_NSTEP',buf,status=st)
+        if (st.eq.0) read(buf,*) nst
+      endif
+      if (it0.lt.0 .or. itime.lt.it0 .or. itime.ge.it0+nst) return
+      tag='x'
+      call get_environment_variable('FFPT_TAG',tag,status=st)
+      write(ts,'(i0)') itime
+      fn='ffpt_'//trim(tag)//'_'//trim(ts)//'.bin'
+      open(1410,file=trim(fn),form='unformatted',access='stream',
+     &     status='replace')
+      call w3('U',u(1:im,1:jm,1:lm),im,jm,lm)
+      call w3('V',v(1:im,1:jm,1:lm),im,jm,lm)
+      call w3('T',t(1:im,1:jm,1:lm),im,jm,lm)
+      call w3('Q',q(1:im,1:jm,1:lm),im,jm,lm)
+      call w3('QCL',qcl(1:im,1:jm,1:lm),im,jm,lm)
+      call w3('QCI',qci(1:im,1:jm,1:lm),im,jm,lm)
+      call w2('P',p(1:im,1:jm),im,jm)
+      close(1410)
+      contains
+      subroutine w2(nm,a,n1,n2)
+      character(len=*) :: nm
+      integer :: n1,n2
+      real*8 :: a(n1,n2)
+      character(len=16) :: nm16
+      nm16=nm
+      write(1410) nm16, 2, n1,n2,1,1
+      write(1410) a
+      end subroutine w2
+      subroutine w3(nm,a,n1,n2,n3)
+      character(len=*) :: nm
+      integer :: n1,n2,n3
+      real*8 :: a(n1,n2,n3)
+      character(len=16) :: nm16
+      nm16=nm
+      write(1410) nm16, 3, n1,n2,n3,1
+      write(1410) a
+      end subroutine w3
+      end subroutine ffpt_dump
+
 
