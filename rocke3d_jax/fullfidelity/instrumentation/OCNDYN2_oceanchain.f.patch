+      SUBROUTINE ffo_snap(ktag)
+C**** FFO: ocean-chain state snapshots (instrumentation only).
+C**** Units 1270 (state stream), 1271 (static geometry).
+C**** Env: FFO_START (first itime), FFO_NFULL (steps with all tags),
+C**** FFO_NSTEP (total steps; steps past NFULL get tags 0,1,12,13,14 only).
+      USE MODEL_COM, only : itime
+      USE OCEAN, only : im,jm,lmo,mo,g0m,s0m,gxmo,gymo,gzmo,
+     *     sxmo,symo,szmo,uo,vo,uod,vod,opbot,opress,ogeoz,kpl,vonp,
+     *     focean,hocean,fgeotherm,lmm,lmu,lmv
+      USE OCEAN_DYN, only : mmi,smu,smv,smw
+      USE KPP_COM, only : g0m1,s0m1,mo1,gxm1,gym1,sxm1,sym1,uo1,vo1,
+     *     uod1,vod1
+      USE SW2OCEAN, only : lsrpd
+      USE STRAITS, only : nmst,lmst,ist,jst,wist,dist,distpg,mmst,must,
+     *     g0mst,gxmst,gzmst,s0mst,sxmst,szmst,moe,g0me,gxme,gyme,gzme,
+     *     s0me,sxme,syme,szme,kn2,xst,yst
+      USE OFLUXES
+      IMPLICIT NONE
+      INTEGER, INTENT(IN) :: ktag
+      INTEGER, SAVE :: istart=-1, nfull=6, nstep=12, iinit=0, igeo=0
+      INTEGER :: ios, it0
+      CHARACTER*64 fn, str
+      LOGICAL :: full
+      IF (iinit.eq.0) THEN
+        iinit = 1
+        CALL get_environment_variable('FFO_START',str)
+        READ(str,*,iostat=ios) it0
+        IF (ios.eq.0) istart = it0
+        CALL get_environment_variable('FFO_NFULL',str)
+        READ(str,*,iostat=ios) it0
+        IF (ios.eq.0) nfull = it0
+        CALL get_environment_variable('FFO_NSTEP',str)
+        READ(str,*,iostat=ios) it0
+        IF (ios.eq.0) nstep = it0
+      ENDIF
+      IF (istart.lt.0) RETURN
+      IF (itime.lt.istart .or. itime.ge.istart+nstep) RETURN
+      full = itime.lt.istart+nfull
+      IF (.not.full .and. ktag.ne.0 .and. ktag.ne.1 .and.
+     *     ktag.ne.12 .and. ktag.ne.13 .and. ktag.ne.14) RETURN
+      IF (igeo.eq.0) THEN
+        igeo = 1
+        OPEN(1271,file='ffo_geom.bin',form='unformatted',
+     *       access='stream',status='replace')
+        WRITE(1271) dble(im),dble(jm),dble(lmo),dble(nmst)
+        WRITE(1271) focean,hocean,fgeotherm
+        WRITE(1271) dble(lmm),dble(lmu),dble(lmv)
+        WRITE(1271) dble(lmst),dble(ist),dble(jst),wist,dist,distpg
+        WRITE(1271) dble(kn2),xst,yst
+        CLOSE(1271)
+      ENDIF
+      WRITE(fn,'(a,i0,a)') 'ffo_state_',itime,'.bin'
+      OPEN(1270,file=trim(fn),form='unformatted',access='stream',
+     *     position='append',status='unknown')
+      WRITE(1270) dble(ktag),dble(itime),dble(im),dble(jm),dble(lmo),
+     *     dble(nmst),dble(lsrpd),dble(size(mo))
+      WRITE(1270) g0m,s0m,gxmo,gymo,gzmo,sxmo,symo,szmo,mo,uo,vo,uod,
+     *     vod
+      WRITE(1270) mmi,smu,smv,smw
+      WRITE(1270) opbot,opress,ogeoz,dble(kpl)
+      WRITE(1270) vonp
+      WRITE(1270) must,mmst,g0mst,gxmst,gzmst,s0mst,sxmst,szmst
+      WRITE(1270) moe,g0me,gxme,gyme,gzme,s0me,sxme,syme,szme
+      IF (ktag.eq.0) THEN
+        WRITE(1270) oprec,oeprec,orsi,orunpsi,oerunpsi,osrunpsi
+      ENDIF
+      IF (ktag.eq.1) THEN
+        WRITE(1270) orsi,oflowo,omelti,oevapor,orunosi,oeflowo,
+     *       oemelti,oe0,oerunosi,osmelti,osrunosi,osolarw,osolari,
+     *       oapress,odmua,odmva,odmui,odmvi
+        WRITE(1270) g0m1
+        WRITE(1270) mo1,gxm1,gym1,sxm1,sym1,uo1,vo1,uod1,vod1,s0m1
+      ENDIF
+      IF (ktag.eq.2) THEN
+        WRITE(1270) odmsi,odhsi,odssi
+      ENDIF
+      CLOSE(1270)
+      RETURN
+      END SUBROUTINE ffo_snap
+
+      subroutine ffo_opcoef(nred,nfft,nfil,nmn,nsm,smooth,nmin,
+     &     jfft,n1fft,n2fft,jfil,i1fil,i2fil,indx_fil,n1fil,n2fil,
+     &     reduco)
+C**** FFO: OPFIL2 setup coefficients, once, unit 1272 (same layout
+C**** as the D75 ffz_opcoef.bin)
+      implicit none
+      integer :: nred,nfft,nfil,nmn,nsm
+      real*8 :: smooth(*),reduco(*)
+      integer :: nmin(*),jfft(*),n1fft(*),n2fft(*),jfil(*),i1fil(*)
+      integer :: i2fil(*),indx_fil(*),n1fil(*),n2fil(*)
+      open(1272,file='ffo_opcoef.bin',form='unformatted',
+     &     access='stream',status='replace')
+      write(1272) dble(nred),dble(nfft),dble(nfil),dble(nmn),dble(nsm)
+      write(1272) dble(smooth(1:nsm)),dble(nmin(1:nmn))
+      write(1272) dble(jfft(1:nfft)),dble(n1fft(1:13)),dble(n2fft(1:13))
+      write(1272) dble(jfil(1:nfil)),dble(i1fil(1:nfil)),
+     &     dble(i2fil(1:nfil))
+      write(1272) dble(indx_fil(1:nfil)),dble(n1fil(1:13)),
+     &     dble(n2fil(1:13))
+      write(1272) reduco(1:nred)
+      close(1272)
+      end subroutine ffo_opcoef
+
