N2OX=0.
CFC11X=0.
CFC12X=0.
CH4X=0.
XGHGX=0.
YGHGX=0.
O2X=0. ! No O2 in socrates files
H2OstratX=1.
wsn_max=0.   ! restrict snow depth to 2 m-h2o (if 0. snow depth is NOT restricted)

